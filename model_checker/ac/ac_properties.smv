-- AC Protocol Properties
-- Total: 260 properties

-- ═══ SAFETY (10) ═══

-- After a FAILED response, the session must eventually stop
CTLSPEC AG (ResponseCode = FAILED -> AX (proto_state = SessionStop | proto_state = proto_state))

-- ChargeProgress=Stop from charge loop must go to PowerDelivery
CTLSPEC AG (proto_state = AC_ChargeLoop & ChargeProgress = Stop -> AX (proto_state = PowerDelivery | proto_state = AC_ChargeLoop))

-- No backward transition from SessionSetup to SupportedAppProtocol
CTLSPEC AG (proto_state = SessionSetup -> AX proto_state != SupportedAppProtocol)

-- No deadlock: every non-terminal state has a successor
CTLSPEC AG (proto_state != SessionStop -> EX TRUE)

-- Retry count bounded at ServiceDetail
CTLSPEC AG (proto_state = ServiceDetail -> retry_count <= 3)

-- Retry count bounded at ScheduleExchange
CTLSPEC AG (proto_state = ScheduleExchange -> retry_count <= 3)

-- Retry count bounded at CertificateInstallation
CTLSPEC AG (proto_state = CertificateInstallation -> retry_count <= 3)

-- Retry count bounded at Authorization
CTLSPEC AG (proto_state = Authorization -> retry_count <= 3)

-- Retry count bounded at PowerDelivery
CTLSPEC AG (proto_state = PowerDelivery -> retry_count <= 3)

-- Retry count bounded at AC_ChargeLoop
CTLSPEC AG (proto_state = AC_ChargeLoop -> retry_count <= 3)

-- ═══ LIVENESS (14) ═══

-- Every session eventually reaches SessionStop
CTLSPEC AG (proto_state = SupportedAppProtocol -> AF proto_state = SessionStop)

-- Eventually leave state SupportedAppProtocol
CTLSPEC AG (proto_state = SupportedAppProtocol -> AF proto_state != SupportedAppProtocol)

-- Eventually leave state SessionSetup
CTLSPEC AG (proto_state = SessionSetup -> AF proto_state != SessionSetup)

-- Eventually leave state AuthorizationSetup
CTLSPEC AG (proto_state = AuthorizationSetup -> AF proto_state != AuthorizationSetup)

-- Eventually leave state Authorization
CTLSPEC AG (proto_state = Authorization -> AF proto_state != Authorization)

-- Eventually leave state CertificateInstallation
CTLSPEC AG (proto_state = CertificateInstallation -> AF proto_state != CertificateInstallation)

-- Eventually leave state ServiceDiscovery
CTLSPEC AG (proto_state = ServiceDiscovery -> AF proto_state != ServiceDiscovery)

-- Eventually leave state ServiceDetail
CTLSPEC AG (proto_state = ServiceDetail -> AF proto_state != ServiceDetail)

-- Eventually leave state ServiceSelection
CTLSPEC AG (proto_state = ServiceSelection -> AF proto_state != ServiceSelection)

-- Eventually leave state AC_ChargeParameterDiscovery
CTLSPEC AG (proto_state = AC_ChargeParameterDiscovery -> AF proto_state != AC_ChargeParameterDiscovery)

-- Eventually leave state ScheduleExchange
CTLSPEC AG (proto_state = ScheduleExchange -> AF proto_state != ScheduleExchange)

-- Eventually leave state PowerDelivery
CTLSPEC AG (proto_state = PowerDelivery -> AF proto_state != PowerDelivery)

-- Eventually leave state AC_ChargeLoop
CTLSPEC AG (proto_state = AC_ChargeLoop -> AF proto_state != AC_ChargeLoop)

-- EVSE processing eventually finishes
CTLSPEC AG (EVSEProcessing = Ongoing -> AF EVSEProcessing = Finished)

-- ═══ COMPLIANCE (45) ═══

-- T1: When guards hold at SupportedAppProtocol, transition to SessionSetup
-- Source: V2G20-1747, V2G20-1484
CTLSPEC AG (proto_state = SupportedAppProtocol & ResponseCode = OK_SuccessfulNegotiation -> AX proto_state = SessionSetup)

-- T2: When guards hold at SessionSetup, transition to AuthorizationSetup
-- Source: V2G20-1749, V2G20-1486
CTLSPEC AG (proto_state = SessionSetup & TimeStamp = e_0 & ResponseCode = OK -> AX proto_state = AuthorizationSetup)

-- T3: When guards hold at SessionSetup, transition to AC_ChargeParameterDiscovery
-- Source: V2G20-2097
CTLSPEC AG (proto_state = SessionSetup & TimeStamp = e_0 & ResponseCode = OK -> AX proto_state = AC_ChargeParameterDiscovery)

-- T4: When guards hold at AuthorizationSetup, transition to Authorization
-- Source: V2G20-1577, V2G20-1971, V2G20-1970
CTLSPEC AG (proto_state = AuthorizationSetup & ResponseCode = OK -> AX proto_state = Authorization)

-- T5: When guards hold at AuthorizationSetup, transition to CertificateInstallation
-- Source: V2G20-1576, V2G20-1970
CTLSPEC AG (proto_state = AuthorizationSetup & ResponseCode = OK -> AX proto_state = CertificateInstallation)

-- T6: When guards hold at CertificateInstallation, transition to CertificateInstallation
-- Source: V2G20-1578, V2G20-1972, V2G20-1973
CTLSPEC AG (proto_state = CertificateInstallation & ReceivedMessage = CertificateInstallationReq & EVSEProcessing = ONGOING & ResponseCode = OK & ResponseCode = OK & ResponseCode = OK & EVSEProcessing = Finished -> AX proto_state = CertificateInstallation)

-- T7: When guards hold at CertificateInstallation, transition to Authorization
-- Source: V2G20-2223, V2G20-1579, V2G20-2225
CTLSPEC AG (proto_state = CertificateInstallation & ReceivedMessage = CertificateInstallationReq & EVSEProcessing = ONGOING & ResponseCode = OK & ResponseCode = OK & ResponseCode = OK & EVSEProcessing = Finished -> AX proto_state = Authorization)

-- T8: When guards hold at Authorization, transition to CertificateInstallation
-- Source: V2G20-2221, V2G20-2226, V2G20-1978
CTLSPEC AG (proto_state = Authorization & ReceivedMessage = AC_ChargeLoopRes & ResponseCode = OK & EVSEProcessing = Finished -> AX proto_state = CertificateInstallation)

-- T9: When guards hold at Authorization, transition to Authorization
-- Source: V2G20-2229, V2G20-1583, V2G20-2227
CTLSPEC AG (proto_state = Authorization & ResponseCode = OK & EVSEProcessing = Finished -> AX proto_state = Authorization)

-- T10: When guards hold at Authorization, transition to ServiceDiscovery
-- Source: V2G20-2221, V2G20-1979, V2G20-2234
CTLSPEC AG (proto_state = Authorization & ReceivedMessage = AC_ChargeLoopRes & ResponseCode = OK & EVSEProcessing = Finished -> AX proto_state = ServiceDiscovery)

-- T11: When guards hold at ServiceDiscovery, transition to SessionStop
-- Source: V2G20-1957, V2G20-2644, V2G20-2645
CTLSPEC AG (proto_state = ServiceDiscovery & MobilityNeedsMode = e_2 & ServiceRenegotiationSupported = TRUE -> AX proto_state = SessionStop)

-- T12: When guards hold at ServiceDiscovery, transition to ServiceDetail
-- Source: V2G20-1585, V2G20-1980
CTLSPEC AG (proto_state = ServiceDiscovery & MobilityNeedsMode = e_2 & ServiceRenegotiationSupported = TRUE -> AX proto_state = ServiceDetail)

-- T13: When guards hold at ServiceDetail, transition to ServiceDetail
-- Source: V2G20-1981, V2G20-1586
CTLSPEC AG (proto_state = ServiceDetail & ServiceID = e_1 & ControlMode = e_2 & ResponseCode = OK -> AX proto_state = ServiceDetail)

-- T14: When guards hold at ServiceDetail, transition to ServiceSelection
-- Source: V2G20-1981, V2G20-1587
CTLSPEC AG (proto_state = ServiceDetail & ServiceID = e_1 & ControlMode = e_2 & ResponseCode = OK -> AX proto_state = ServiceSelection)

-- T15: When guards hold at ServiceSelection, transition to AC_ChargeParameterDiscovery
-- Source: V2G20-1983, V2G20-1590
CTLSPEC AG (proto_state = ServiceSelection & ResponseCode = OK -> AX proto_state = AC_ChargeParameterDiscovery)

-- T16: When guards hold at AC_ChargeParameterDiscovery, transition to ScheduleExchange
-- Source: V2G20-2659, V2G20-2658
CTLSPEC AG (proto_state = AC_ChargeParameterDiscovery & EnergyTransferMode = AC -> AX proto_state = ScheduleExchange)

-- T17: When guards hold at ScheduleExchange, transition to ScheduleExchange
-- Source: V2G20-1593, V2G20-1986, V2G20-1987
CTLSPEC AG (proto_state = ScheduleExchange & GoToPause = TRUE & EVSEProcessing = Ongoing -> AX proto_state = ScheduleExchange)

-- T18: When guards hold at ScheduleExchange, transition to PowerDelivery
-- Source: V2G20-2122, V2G20-2123, V2G20-1989
CTLSPEC AG (proto_state = ScheduleExchange & GoToPause = TRUE & EVSEProcessing = Ongoing -> AX proto_state = PowerDelivery)

