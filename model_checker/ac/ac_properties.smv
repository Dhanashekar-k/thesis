-- ═══ INVARIANT (12) ═══

-- Global invariant: certificateValidationConformance = IETF_RFC_5280
-- Source: V2G20-1001
CTLSPEC AG (certificateValidationConformance = IETF_RFC_5280)

-- Global invariant: WLAN_STA_MAC_Address_Randomization = true
-- Source: V2G20-2253
CTLSPEC AG (WLAN_STA_MAC_Address_Randomization = TRUE)

-- In Authorization, EVSEProcessing constrained to: Finished, Ongoing
CTLSPEC AG (proto_state = Authorization -> (EVSEProcessing = Finished | EVSEProcessing = Ongoing))

-- In CertificateInstallation, EVSEProcessing constrained to: Finished, ONGOING, Ongoing
CTLSPEC AG (proto_state = CertificateInstallation -> (EVSEProcessing = Finished | EVSEProcessing = ONGOING | EVSEProcessing = Ongoing))

-- In ServiceDiscovery, ServiceRenegotiationSupported constrained to: True
CTLSPEC AG (proto_state = ServiceDiscovery -> (ServiceRenegotiationSupported = e_True))

-- In ScheduleExchange, EVSEProcessing constrained to: Finished, Ongoing
CTLSPEC AG (proto_state = ScheduleExchange -> (EVSEProcessing = Finished | EVSEProcessing = Ongoing))

-- In PowerDelivery, EVSEProcessing constrained to: NOT_APPLICABLE
CTLSPEC AG (proto_state = PowerDelivery -> (EVSEProcessing = NOT_APPLICABLE))

-- In PowerDelivery, EVProcessing constrained to: Ongoing
CTLSPEC AG (proto_state = PowerDelivery -> (EVProcessing = Ongoing))

-- In PowerDelivery, ChargeProgress constrained to: Standby, Stop
CTLSPEC AG (proto_state = PowerDelivery -> (ChargeProgress = Standby | ChargeProgress = Stop))

-- In SessionStop, EVSENotification constrained to: Terminate
CTLSPEC AG (proto_state = SessionStop -> (EVSENotification = Terminate))

-- In SessionStop, ServiceRenegotiationSupported constrained to: True
CTLSPEC AG (proto_state = SessionStop -> (ServiceRenegotiationSupported = e_True))

-- In SessionStop, ChargingSession constrained to: Pause, ServiceRenegotiation, Terminate
CTLSPEC AG (proto_state = SessionStop -> (ChargingSession = Pause | ChargingSession = ServiceRenegotiation | ChargingSession = Terminate))

