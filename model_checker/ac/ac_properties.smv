-- Source: V2G20-2012, V2G20-1440
CTLSPEC AG (proto_state = AC_ChargeLoop & ReceivedMessage = AC_ChargeLoopRes & MobilityNeedsMode = e_2 -> AX proto_state = AC_ChargeLoop)

-- T23: When guards hold at PowerDelivery, transition to SessionStop
-- Source: V2G20-1623
CTLSPEC AG (proto_state = PowerDelivery & PayloadType = ScheduleRenegotiationPayloadID & EVSEProcessing = NOT_APPLICABLE & ResponseCode = OK & EVProcessing = Ongoing & ChargeProgress = Stop & ChargeProgress = Standby -> AX proto_state = SessionStop)

-- T24: When guards hold at SessionStop, transition to ServiceDiscovery
-- Source: V2G20-1643, V2G20-1477
CTLSPEC AG (proto_state = SessionStop & EVPowerProfileEntry = e_0kW & ResponseCode = OK & EVSENotification = Terminate & ServiceRenegotiationSupported = TRUE -> AX proto_state = ServiceDiscovery)

-- T25: When guards hold at Authorization, transition to SessionStop
-- Source: V2G20-2644, V2G20-2645
CTLSPEC AG (proto_state = Authorization & ResponseCode = OK & EVSEProcessing = Finished -> AX proto_state = SessionStop)

