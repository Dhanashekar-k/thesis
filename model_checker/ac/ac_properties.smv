-- Source: V2G20-2644, V2G20-2645
CTLSPEC AG (proto_state = ServiceDetail & ServiceID = e_1 & ControlMode = e_2 & ResponseCode = OK -> AX proto_state = SessionStop)

-- T30: When guards hold at ServiceSelection, transition to SessionStop
-- Source: V2G20-2644, V2G20-2645
CTLSPEC AG (proto_state = ServiceSelection & ResponseCode = OK -> AX proto_state = SessionStop)

-- T31: When guards hold at AC_ChargeParameterDiscovery, transition to SessionStop
-- Source: V2G20-2644, V2G20-2645
CTLSPEC AG (proto_state = AC_ChargeParameterDiscovery & EnergyTransferMode = AC -> AX proto_state = SessionStop)

-- T32: When guards hold at ScheduleExchange, transition to SessionStop
-- Source: V2G20-2644, V2G20-2645
CTLSPEC AG (proto_state = ScheduleExchange & GoToPause = TRUE & EVSEProcessing = Ongoing -> AX proto_state = SessionStop)

-- In SupportedAppProtocol, ResponseCode must be one of: OK_SuccessfulNegotiation, OK_SuccessfulNegotiationWithMinorDeviation
CTLSPEC AG (proto_state = SupportedAppProtocol -> (ResponseCode = OK_SuccessfulNegotiation | ResponseCode = OK_SuccessfulNegotiationWithMinorDeviation))

-- In SessionSetup, ResponseCode must be one of: OK_NewSessionEstablished
CTLSPEC AG (proto_state = SessionSetup -> (ResponseCode = OK_NewSessionEstablished))

-- In AuthorizationSetup, ResponseCode must be one of: OK
CTLSPEC AG (proto_state = AuthorizationSetup -> (ResponseCode = OK))

-- In Authorization, ResponseCode must be one of: OK
CTLSPEC AG (proto_state = Authorization -> (ResponseCode = OK))

-- In CertificateInstallation, ResponseCode must be one of: OK, WARNING_CertificateValidationError
CTLSPEC AG (proto_state = CertificateInstallation -> (ResponseCode = OK | ResponseCode = WARNING_CertificateValidationError))

-- In ServiceDiscovery, ResponseCode must be one of: OK
CTLSPEC AG (proto_state = ServiceDiscovery -> (ResponseCode = OK))

-- In ServiceDetail, ResponseCode must be one of: OK, FAILED_ServiceIDInvalid
CTLSPEC AG (proto_state = ServiceDetail -> (ResponseCode = OK | ResponseCode = FAILED_ServiceIDInvalid))

-- In ServiceSelection, ResponseCode must be one of: OK, FAILED_ServiceSelectionInvalid
CTLSPEC AG (proto_state = ServiceSelection -> (ResponseCode = OK | ResponseCode = FAILED_ServiceSelectionInvalid))

-- In AC_ChargeParameterDiscovery, ResponseCode must be one of: FAILED_WrongChargeParameter
CTLSPEC AG (proto_state = AC_ChargeParameterDiscovery -> (ResponseCode = FAILED_WrongChargeParameter))

-- In ScheduleExchange, ResponseCode must be one of: OK, WARNING_EVPowerProfileViolation, FAILED_EVPowerProfileViolation
CTLSPEC AG (proto_state = ScheduleExchange -> (ResponseCode = OK | ResponseCode = WARNING_EVPowerProfileViolation | ResponseCode = FAILED_EVPowerProfileViolation))

-- In PowerDelivery, ResponseCode must be one of: OK, WARNING_StandbyNotAllowed
CTLSPEC AG (proto_state = PowerDelivery -> (ResponseCode = OK | ResponseCode = WARNING_StandbyNotAllowed))

-- In AC_ChargeLoop, ResponseCode must be one of: WARNING_EVPowerProfileViolation, FAILED_EVPowerProfileViolation
CTLSPEC AG (proto_state = AC_ChargeLoop -> (ResponseCode = WARNING_EVPowerProfileViolation | ResponseCode = FAILED_EVPowerProfileViolation))

-- In SessionStop, ResponseCode must be one of: OK, FAILED, WARNING
CTLSPEC AG (proto_state = SessionStop -> (ResponseCode = OK | ResponseCode = FAILED | ResponseCode = WARNING))

