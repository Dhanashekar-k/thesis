        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2259] If the EVCC is unable to successfully authenticate the CSO’s authentication server, it shall decline to establish a wireless connection with the CSO’s access point.",
            "block_bbox": [
                70,
                867,
                1053,
                923
            ],
            "block_id": 10,
            "block_order": 10,
