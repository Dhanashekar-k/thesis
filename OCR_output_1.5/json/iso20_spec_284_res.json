        {
            "block_label": "text",
            "block_content": "[V2G20-2140] If AC was selected as energy transfer mode, the Power element shall define the maximum amount of apparent power to be drawn from the EV when the element of type EVPowerScheduleEntryType is active. The power can freely be drawn from any phase, but the real AC polyphase discharging behavior should always respect the maximum allowed asymmetry at the grid connection point as defined by the local grid code.",
            "block_bbox": [
                135,
                487,
                1122,
                643
            ],
            "block_id": 4,
            "block_order": 2,
            "group_id": 4,
