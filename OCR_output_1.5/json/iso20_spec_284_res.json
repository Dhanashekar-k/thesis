        {
            "block_label": "table",
            "block_content": "<table><tr><td>Element name</td><td>Type</td><td>Semantics</td></tr><tr><td rowspan=\"2\">Duration</td><td>simpleType:</td><td rowspan=\"2\">Duration of the EVPowerScheduleEntries. The amount of seconds that define the duration of the given EVPowerScheduleEntries.</td></tr><tr><td>xs:unsignedInt</td></tr><tr><td rowspan=\"3\">Power</td><td>complexType:</td><td rowspan=\"3\">Defines maximum amount of power for the duration of this EVPowerScheduleEntry to be discharged from the EV battery through EVSE power outlet. Negative values are used for discharging.</td></tr><tr><td>RationalNumberType</td></tr><tr><td>refer to 8.3.5.3.8</td></tr></table>",
