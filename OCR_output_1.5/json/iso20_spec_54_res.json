            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2248] When the CSO offers a wireless medium to establish a physical connection to an AP (see ISO 15118-8 for details), the CSO shall use WPA3-Enterprise or WPA2-Enterprise according to IEEE802.1X.",
            "block_bbox": [
                137,
                1182,
                1120,
                1261
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
