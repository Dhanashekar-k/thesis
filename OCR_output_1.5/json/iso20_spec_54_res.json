        {
            "block_label": "text",
            "block_content": "[V2G20-2247] When the EVCC uses a wireless medium to establish a physical connection to an AP (see ISO 15118-8 for details), the EV's WLAN STA (see ISO 15118-8 for details) shall use WPA3-Enterprise or WPA2-Enterprise according to IEEE 802.1X.",
            "block_bbox": [
                137,
                1081,
                1119,
                1161
            ],
            "block_id": 13,
            "block_order": 12,
            "group_id": 13,
            "block_polygon_points": [
                [
                    137.0,
                    1081.0
