        },
        {
            "block_label": "text",
            "block_content": "RADIUS is not just limited to WPT, it can be used in other wireless communication use cases like ACDP or AC / DC wireless charging.",
            "block_bbox": [
                137,
                299,
                1121,
                353
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
                [
