        {
            "block_label": "text",
            "block_content": "[V2G20-1346] The EVSE shall calculate the Power values in the ScheduleTuple based on the parameter EVSENominalVoltage.",
            "block_bbox": [
                139,
                1038,
                1120,
                1091
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "block_polygon_points": [
