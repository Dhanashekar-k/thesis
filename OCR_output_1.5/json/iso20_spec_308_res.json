                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1347] The EVCC shall use the value EVSENominalVoltage provided by the SECC to calculate the maximum available charging current based on the Power values provided in the PowerSchedule of the ScheduleExchangeRes and the Power values in the element EVPowerProfile of the PowerDeliveryReq message.",
            "block_bbox": [
                137,
                1111,
                1120,
                1218
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "block_polygon_points": [
