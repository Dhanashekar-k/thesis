        {
            "block_label": "text",
            "block_content": "[V2G20-1828] When charging or discharging the EV shall respect the maximum power imbalance between all 3 phases (utilized or not) using the limit defined by Maximum Power Asymmetry. This, however, shall not apply if the power asymmetry is the result of a technique which implements a grid code requirement that has a higher priority than the static Maximum Power Asymmetry parameter.",
            "block_bbox": [
                136,
                1238,
                1122,
                1371
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
                [
                    136.0,
                    1238.0
                ],
                [
                    1122.0,
                    1238.0
                ],
                [
                    1122.0,
                    1371.0
                ],
                [
                    136.0,
                    1371.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 1 If the element MaximumPowerAsymmetry is not present, no asymmetric limitation applies.",
            "block_bbox": [
                138,
                1391,
                1019,
                1418
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
