        {
            "block_label": "table",
            "block_content": "<table><tr><td>Element Name</td><td>Type</td><td>Semantics</td></tr><tr><td>SessionID</td><td>simpleType: sessionIDType refer to Annex A for the type definition</td><td>This message element is used by EVCC and SECC for uniquely identifying a V2G communication session. Refer to 8.3.4.1 for requirements relative to this message element.</td></tr><tr><td>TimeStamp</td><td>simpleType xs:unsignedLong</td><td>Timestamp that marks the time of message creation. The value is encoded at microseconds resolution in SECC time, a concept that is defined in 8.3.3.3</td></tr><tr><td>xmlsig:Signature</td><td>separate namespace: &quot;http://www.w3.org/2000/09/xmldig#&quot;</td><td>Optional: This element is used if a certain V2G message requires to be signed.</td></tr></table>",
