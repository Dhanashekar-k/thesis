            ]
        },
        {
            "block_label": "text",
            "block_content": "As mentioned in Table B.5 and Table B.6, it is optional to include the \"certificatePolicies\" extension in any of the charge point operator certificates. If the \"certificatePolicies\" extension is included, it can be marked as non-critical so that the relying party can ignore this extension if it cannot process it. This is done to improve the interoperability.",
            "block_bbox": [
                135,
                1309,
                1123,
                1415
            ],
            "block_id": 4,
