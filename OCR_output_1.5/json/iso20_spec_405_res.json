        {
            "block_label": "text",
            "block_content": "PowerDeliveryReq message violates a power limitation provided in ScheduleExchangeRes.",
            "block_bbox": [
                252,
                167,
                1053,
                222
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
