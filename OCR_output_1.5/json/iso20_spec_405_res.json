            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1954] If the response code \"WARNING_PowerToleranceNotConfirmed\" has been sent, and EVSENotification in EVSEStatus has been set to \"ScheduleRenegotiation\" in the latest PowerDeliveryRes message the EVCC shall initiate a schedule renegotiation.",
            "block_bbox": [
