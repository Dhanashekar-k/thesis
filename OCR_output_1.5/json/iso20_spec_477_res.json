            ]
        },
        {
            "block_label": "text",
            "block_content": "- the EMAID itself (see [V2G20-2588]) shall be the value of the Common Name (CN) of the Distinguished Name (DN);",
            "block_bbox": [
                283,
                1384,
                1052,
                1435
