        {
            "block_label": "table",
            "block_content": "<table><tr><td colspan=\"3\">ISO 15118-20 certificate profiles</td><td>eMSP root CA Root</td><td>eMSP sub-CA1 Sub</td><td>eMSP sub-CA2 Sub/leaf</td><td>Contract certificate Leaf</td></tr><tr><td></td><td></td><td>accessLocation</td><td>-</td><td>-</td><td>-</td><td>x (A URL to a distribution point of current (daily) additional information to the contract. Syntax: An alphanumeric string with a maximum length of 255 characters)</td></tr><tr><td rowspan=\"3\">SignatureAlgorithm</td><td colspan=\"2\">AlgorithmIdentifier</td><td>x</td><td>x</td><td>x</td><td>x</td></tr><tr><td colspan=\"2\">algorithm</td><td>x id-Ed448</td><td>x id-Ed448</td><td>x id-Ed448</td><td>x id-Ed448</td></tr><tr><td colspan=\"2\">parameters</td><td>-</td><td>-</td><td>-</td><td>-</td></tr><tr><td colspan=\"3\">SignatureValue</td><td>(Raw BIT STRING)</td><td>(Raw BIT STRING)</td><td>(Raw BIT STRING)</td><td>(Raw BIT STRING)</td></tr></table>",
