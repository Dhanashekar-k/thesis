        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2589] EMAID shall be contained in the subject field of the contract certificate as follows:",
            "block_bbox": [
                70,
                1333,
                1028,
                1360
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
