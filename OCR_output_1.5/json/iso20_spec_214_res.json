                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-5017] If the SECC has received the WPT_PairingReq message with the parameter ObservedIDCode set to a pairing identification code and the validation of the ObservedIDCode succeeds it shall respond with a WPT_PairingRes message with the parameter ResponseCode equal to \"OK\".",
            "block_bbox": [
                137,
                464,
