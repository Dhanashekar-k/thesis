        {
            "block_label": "text",
            "block_content": "[V2G20-1260] The value of the ScheduleTupleID element shall be equal to one of the values of the ScheduleTupleID elements (see 8.3.5.3.17) in the list of ScheduleTuple elements (see 8.3.5.3.15) provided in the ScheduleExchangeRes message (see 8.3.4.4.2.3).",
            "block_bbox": [
