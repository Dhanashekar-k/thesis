        {
            "block_label": "text",
            "block_content": "In the CertificateInstallationReq message, the EVCC shall use the OEM provisioning certificate in accordance with the configuration mechanism defined in [V2G20-2320]. In case EVCC supports multiple curves, it may send multiple CertificateInstallationReq messages, using the OEM provisioning certificate corresponding to the respective curve.",
            "block_bbox": [
