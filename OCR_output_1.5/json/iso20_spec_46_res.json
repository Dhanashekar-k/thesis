                ],
                [
                    1123.0,
                    169.0
                ],
                [
                    1123.0,
                    327.0
                ],
                [
                    135.0,
                    327.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2607]\nThe V2G entity shall ensure that the random number used to re-seed/re-initialize a DRBG has the minimum amount of entropy required for the particular application/feature/function as defined by this specification document. The entropy input and the seed shall be kept secret.",
            "block_bbox": [
                139,
                347,
                288,
                375
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    139.0,
                    347.0
                ],
                [
                    288.0,
                    347.0
                ],
                [
                    288.0,
                    375.0
                ],
                [
                    139.0,
                    375.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "",
            "block_bbox": [
                322,
                347,
                1122,
                453
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    322.0,
