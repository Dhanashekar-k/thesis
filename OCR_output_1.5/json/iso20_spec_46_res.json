                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2608]",
            "block_bbox": [
                138,
                708,
                288,
                736
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
