        },
        {
            "block_label": "text",
            "block_content": "20-2608] The V2G entity shall keep a random number generated according to [V2G20-835] secret and shall use this random number only once.",
            "block_bbox": [
                192,
                708,
                1117,
                762
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
