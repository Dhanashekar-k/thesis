        {
            "block_label": "text",
            "block_content": "[V2G20-2287] The SDP client shall stop sending SECC discovery request messages after a valid SECC discovery response message has been received with \"DiagStatus\" = \"finished with EVSEID\" or \"finished without EVSEID\".",
            "block_bbox": [
                137,
                370,
                1122,
                448
