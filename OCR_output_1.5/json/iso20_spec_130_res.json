        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2288] For wireless communication the SDP client shall wait at least 250 ms before sending the next SECC discovery request message after an SECC discovery response message has been received with the payload parameter \"DiagStatus\" = \"ongoing\".",
