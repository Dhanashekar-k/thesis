        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2286] For wireless communication the SDP client shall send the SECC discovery request message with the payload type value SDPRequestWirelessPayloadID as defined in Table 14, Figure 3 and Figure 4.",
            "block_bbox": [
                136,
