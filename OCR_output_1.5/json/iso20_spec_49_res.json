                    764.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-030] After the SDP server is started successfully, the SECC shall wait for a TLS connection initialization depending on the SDP response message as defined in 7.10.1.6.",
            "block_bbox": [
                68,
                785,
                1052,
                841
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
                    68.0,
                    785.0
                ],
                [
                    1052.0,
                    785.0
                ],
                [
                    1052.0,
                    841.0
                ],
                [
                    68.0,
                    841.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-031] The SECC shall wait until the TLS connection is established.",
            "block_bbox": [
                68,
                861,
                820,
                890
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    68.0,
                    861.0
                ],
                [
                    820.0,
                    861.0
                ],
                [
                    820.0,
                    890.0
                ],
                [
                    68.0,
                    890.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-032] The SECC shall stop waiting for establishing the TLS connection when V2G\\_SECC\\_CommunicationSetup\\_Timer is equal or larger than V2G\\_SECC\\_CommunicationSetup\\_Performance\\_Time.",
            "block_bbox": [
                68,
                910,
                1054,
                992
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
