        },
        {
            "block_label": "text",
            "block_content": "[V2G20-722] If [V2G20-033] applies the SECC may stop the SDP server after successful establishment of a TLS connection.",
            "block_bbox": [
                69,
                1086,
                1053,
                1144
            ],
