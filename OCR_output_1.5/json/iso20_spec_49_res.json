        {
            "block_label": "text",
            "block_content": "[V2G20-1776] If the SECC received the message SessionStopReq with parameter ChargingSession equal to \"Terminate\" it shall terminate the Data-Link (D-LINK_TERMINATE.request()) 2 s after sending the message SessionStopRes.",
            "block_bbox": [
                69,
                1239,
                1053,
                1320
            ],
            "block_id": 14,
            "block_order": 14,
