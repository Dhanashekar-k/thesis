        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1777] If the SECC received the message SessionStopReq with parameter ChargingSession equal to \"Pause\" it shall pause the Data-Link (D-LINK_PAUSE.request()) after sending the message SessionStopRes with ResponseCode set to \"OK\" and follow the sleep and wake-up requirements defined in ISO 15118-3:2015, 7.6.",
            "block_bbox": [
                69,
                1340,
                1054,
                1447
            ],
            "block_id": 15,
