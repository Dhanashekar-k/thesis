                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-033] After the TLS connection is established, the SECC shall wait for the initialization of the V2G communication session as defined in Clause 8.",
            "block_bbox": [
                69,
                1012,
                1054,
                1068
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
