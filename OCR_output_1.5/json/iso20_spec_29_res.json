                ],
                [
                    284.0,
                    1425.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "d) Each certificate in the certificate chain matches the appropriate certificate profile as defined in Annex B. This includes checking the following:",
            "block_bbox": [
                285,
                1427,
                1052,
                1475
            ],
            "block_id": 18,
            "block_order": 18,
            "group_id": 18,
            "block_polygon_points": [
                [
                    285.0,
                    1427.0
                ],
                [
                    1052.0,
                    1427.0
                ],
                [
                    1052.0,
                    1475.0
                ],
                [
                    285.0,
                    1475.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- the key length of each certificate in the certificate chain matches the key length specified by that certificate’s profile in Annex B;",
            "block_bbox": [
                364,
                1477,
                1051,
                1526
            ],
            "block_id": 19,
            "block_order": 19,
            "group_id": 19,
            "block_polygon_points": [
