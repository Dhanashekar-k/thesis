        {
            "block_label": "text",
            "block_content": "NOTE 14 As mentioned in Annex B, there are many mandatory and optional parameters in a certificate. Some parameters have well defined fixed lengths while others are variable length parameters. The certificate issuer can experiment with different optional parameters, different parameter data for variable length parameters, etc. to stay within the bounds of [V2G20-1234]. For example, if the OCSP responder address is too long, the certificate issuer can use methodologies to shorten the address to keep the certificate length within the bounds of [V2G20-1234].",
            "block_bbox": [
                68,
                168,
                1054,
                288
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
                    68.0,
                    168.0
                ],
                [
                    1054.0,
                    168.0
                ],
                [
                    1054.0,
                    288.0
                ],
                [
                    68.0,
                    288.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1004] Certificates shall be issued and signed by the CA within the validity of its own certificate.",
            "block_bbox": [
                70,
                308,
                1053,
                362
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    70.0,
                    308.0
                ],
                [
                    1053.0,
                    308.0
                ],
                [
                    1053.0,
                    362.0
                ],
                [
                    70.0,
                    362.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-911] If only one sub-CA layer is used, i.e. a sub-CA signed by a root CA directly signs leaf certificates, the profile of sub-CA2 shall apply for that sub-CA.",
            "block_bbox": [
                70,
                384,
                1054,
                438
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    70.0,
                    384.0
                ],
                [
                    1054.0,
                    384.0
                ],
                [
                    1054.0,
                    438.0
                ],
                [
                    70.0,
                    438.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1003] All certificate chains (except where a cross certificate is used) shall have a maximum length of 3.",
            "block_bbox": [
                70,
                459,
                1052,
                512
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    70.0,
                    459.0
                ],
                [
                    1052.0,
                    459.0
                ],
                [
                    1052.0,
                    512.0
                ],
                [
                    70.0,
                    512.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 15 The certificate chain includes the leaf certificate. The certificate chain does not include the root certificate.",
            "block_bbox": [
                68,
                535,
                1053,
                584
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
