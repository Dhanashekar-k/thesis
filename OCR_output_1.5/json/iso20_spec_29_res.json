                ],
                [
                    68.0,
                    584.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 16 This means, at most two sub-CA levels can be used.",
            "block_bbox": [
                68,
                606,
                606,
                632
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
