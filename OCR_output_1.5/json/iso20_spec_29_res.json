        },
        {
            "block_label": "text",
            "block_content": "NOTE 18 A cross certificate adds one more level.",
            "block_bbox": [
                68,
                773,
                504,
                800
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
