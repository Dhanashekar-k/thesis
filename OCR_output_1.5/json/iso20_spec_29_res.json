                    946.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1853] A cross-certificate shall not be valid beyond the validity period of the cross-certified CA's certificate and cross-certifying CA's certificate.",
            "block_bbox": [
                70,
                968,
                1051,
                1023
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
