                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1002] When cross-certification is used, the certificate chain sent shall include the cross-certificate.",
            "block_bbox": [
                70,
                821,
                1052,
                876
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
