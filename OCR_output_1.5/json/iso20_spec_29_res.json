            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 19 The profile of a cross certificate differs from that of other CA certificates by the validity period and the use of Subject Information Access extension. See Annex B for further details.",
            "block_bbox": [
                68,
                897,
                1053,
                946
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
