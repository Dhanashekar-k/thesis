                    632.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1005] All certificate chains, including a cross certificate, shall have a maximum length of 4.",
            "block_bbox": [
                68,
                653,
                1048,
                682
            ],
            "block_id": 7,
            "block_order": 7,
