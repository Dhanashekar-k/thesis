            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2423] When the EVCC receives a \"CertificateRequest\" message, the EVCC shall check that extension \"status_request\" is not present in the \"CertificateRequest\" message. If extension \"status_request\" is present in the \"CertificateRequest\" message, the EVCC shall disregard this extension and continue with the TLS handshake as if the \"CertificateRequest\" message did not contain those extension(s).",
            "block_bbox": [
                69,
                1305,
                1054,
                1437
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
