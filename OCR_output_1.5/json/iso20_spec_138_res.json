        {
            "block_label": "text",
            "block_content": "Examples below illustrate the exchange of supportedAppProtocol messages between the EVCC and the SECC. In the request message, the EVCC sends a prioritized list of supported application layer protocols to the SECC. The Priority element indicates to the SECC which protocol is preferred by the EVCC. The SchemaID is simply a running counter, enabling the SECC to refer to a specific entry. In the response message the SECC confirms \"urn:iso:std:iso:15118:-20:DC\" by setting the SchemaID element to \"2\" and using a ResponseCode equal to \"OK_SuccessfulNegotiation\".",
            "block_bbox": [
                136,
                703,
                1122,
                860
            ],
            "block_id": 5,
            "block_order": 3,
            "group_id": 5,
            "block_polygon_points": [
