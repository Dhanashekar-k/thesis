        {
            "block_label": "table",
            "block_content": "<table><tr><td>Element Name</td><td>Type</td><td>Semantics</td></tr><tr><td>ScheduleTupleID</td><td>simpleType:numericIDTyperefer to Annex A for the type definition</td><td>Mandatory for scheduled control mode, not applicable for dynamic control mode:Unique identifier within an energy transfer session for a ScheduleTuple element.An SAID remains a unique identifier for one schedule throughout an energy transfer session.</td></tr><tr><td>ChargingSchedule</td><td>complexType:ChargingScheduleTyperefer to 8.3.5.3.40</td><td>Encapsulating element describing all relevant details for the charging schedule.</td></tr><tr><td>DischargingSchedule</td><td>complexType:ChargingScheduleTyperefer to 8.3.5.3.40</td><td>Optional:Encapsulating element describing all relevant details for the discharging schedule.</td></tr></table>",
