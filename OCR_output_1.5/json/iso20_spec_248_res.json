        },
        {
            "block_label": "text",
            "block_content": "The EV energy request parameters defined below are used by the EV to inform the EVSE of its energy demands and limitations. They are instantaneous values that will change over time during the energy transfer loops. They are calculated, updated and sent during the energy transfer loop by the EV and they form the foundation for the DynamicControlMode.",
            "block_bbox": [
                135,
                1193,
                1122,
                1299
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    135.0,
                    1193.0
                ],
                [
                    1122.0,
                    1193.0
                ],
                [
                    1122.0,
                    1299.0
                ],
                [
                    135.0,
                    1299.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The EV shall ensure that at any time: EV Minimum Energy Level ≤ EV Target Energy Level ≤ EV Maximum Energy Level and therefore the resulting energy requests satisfy the following relationship: EVMinimumEnergyRequest ≤ EVTargetEnergyRequest ≤ EVMaximumEnergyRequest.",
            "block_bbox": [
                321,
                1319,
                1120,
                1427
            ],
            "block_id": 13,
            "block_order": 13,
            "group_id": 13,
