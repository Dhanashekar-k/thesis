        {
            "block_label": "text",
            "block_content": "D8 Validity period of SECC certificates: Mechanisms to revoke SECC certificates are not specified but instead, SECC certificates are short term certificates.",
            "block_bbox": [
                69,
                168,
                1053,
                221
            ],
