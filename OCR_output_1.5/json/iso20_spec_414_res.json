            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 3 If the EVSE detects a CP state C to CP state B change, it will execute an emergency shutdown according to IEC 61851-23-1. It can keep communication open to allow the disconnection of the ACDP and to give status information about the ACDP to the EV.",
            "block_bbox": [
                134,
                636,
                1123,
                709
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "block_polygon_points": [
