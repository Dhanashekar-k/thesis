                    934.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2596] The issuer of the certificate shall describe the information with three additional access descriptions for \"AccessDescription\". Here are the definitions in ASN.1 notation:",
            "block_bbox": [
                138,
                956,
                1119,
                1035
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "block_polygon_points": [
                [
                    138.0,
                    956.0
                ],
                [
                    1119.0,
                    956.0
                ],
                [
                    1119.0,
                    1035.0
                ],
                [
                    138.0,
                    1035.0
                ]
            ]
        },
        {
            "block_label": "algorithm",
            "block_content": "ISO15118-Extensions { iso(1) standard(0) 15118 part20(20) extensions(0) }\nDEFINITIONS :=\nBEGIN\nid-15118-20-ad    OBJECT IDENTIFIER := { iso(1) standard(0) 15118 part20(20) extensions(0) }\n-- Public Storage Key of EVCC's TPM\nid-tpmStorageKey    OBJECT IDENTIFIER := { id-15118-20-ad tpmStorageKey(4) }\n-- Policy Digest for EVCC's TPM Contract Keys\nid-tpmPolicyDigest    OBJECT IDENTIFIER := { id-15118-20-ad tpmPolicyDigest(5) }\nEND",
            "block_bbox": [
                151,
                1061,
                1114,
                1325
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
