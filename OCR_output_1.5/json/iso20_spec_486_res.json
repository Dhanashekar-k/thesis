        {
            "block_label": "text",
            "block_content": "[V2G20-2595] In case the OEM provisioning certificate provided by/for the EVCC contains the non-critical extension \"TPMStorageKey\" and/or \"TpmPolicyDigest\", the SA/eMSP shall use the method described in 7.9.2.5.3 to encrypt the private contract certificate key for this EVCC.",
            "block_bbox": [
                136,
                830,
                1120,
                934
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "block_polygon_points": [
