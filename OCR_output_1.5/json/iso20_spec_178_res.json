                    492
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 4 This means that if EVCC not equipped with a TPM uses an alternative curve and receives a SECP521_EncryptedPrivateKey, the EVCC will not process the SignedInstallationData.",
            "block_bbox": [
                136,
                645,
                1120,
                695
