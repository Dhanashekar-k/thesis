            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 5 An EVCC with a TPM will store/install the contract certificate private key in TPM and follow the requirements for decryption of the private key for EVCCs with TPM. Similarly, an EVCC without a TPM will store/install the contract certificate private key in HSM (or whatever other mechanisms it is using to securely store the private keys) and follow the requirements for decryption of the private key for EVCCs without TPM.",
            "block_bbox": [
                136,
                869,
                1121,
                966
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
