                    471.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2707] Upon reception of SignedInstallationData, the EVCC shall check that the received encrypted contract key uses the ECC algorithm in accordance with the configuration parameter [V2G20-2320] or with the OEM provisioning certificate the EVCC provided in the CertificateInstallationReq, otherwise, the EVCC shall regard the received message as invalid, and discard the message.",
            "block_bbox": [
                136,
                492,
                1120,
                624
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    136,
                    492
                ],
                [
                    142,
                    623
                ],
                [
