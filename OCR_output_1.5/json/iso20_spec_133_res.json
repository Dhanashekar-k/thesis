        },
        {
            "block_label": "paragraph_title",
            "block_content": "7.10.1.10.2 Loss of association PPD exception handling",
            "block_bbox": [
                68,
                594,
                633,
                622
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    68.0,
