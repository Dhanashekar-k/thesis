                [
                    67.0,
                    902.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "7.10.1.11 SDP for wireless communication application for WPT",
            "block_bbox": [
                150,
                921,
                803,
                948
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
