                    704.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 2 Refer to 8.6.3 for additional requirements of response codes applicable to the SessionSetupRes message.",
            "block_bbox": [
                137,
                726,
