        {
            "block_label": "text",
            "block_content": "[V2G20-2613] If the check as described by [V2G20-2539] fails, i.e. the V2G communication session has not been resumed with the same SECC with which the EVCC had initially setup this same V2G communication session, the EVCC shall consider this as a new V2G communication session.",
            "block_bbox": [
                137,
                772,
                1120,
                877
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
