        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2614] If [V2G20-2613] applies, the EVCC shall purge all data associated with the paused V2G communication session and terminate that V2G communication session.",
            "block_bbox": [
                137,
                899,
