        {
            "block_label": "text",
            "block_content": "[V2G20-2615] If the EVCC received SessionSetupRes message with the ResponseCode set to \"OK_NewSessionEstablished\" and the SessionID set to a value different than the value that it sent in SessionSetupReq message to resume the previously paused V2G communication session, the EVCC shall consider this as a new V2G communication session.",
            "block_bbox": [
