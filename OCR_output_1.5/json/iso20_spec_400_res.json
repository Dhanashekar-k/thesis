                    369.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- OK:",
            "block_bbox": [
                215,
                393,
                301,
                417
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
