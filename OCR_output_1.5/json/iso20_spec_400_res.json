        {
            "block_label": "text",
            "block_content": "The basic error handling for a request-response-message pair and a request-response message sequence is based on the ResponseCode included in the response message of the SECC. Depending on the value in the ResponseCode the EVCC decides if it can proceed with the standard request-response message sequence or if it handles an error.",
            "block_bbox": [
                136,
                217,
                1121,
                321
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    136.0,
                    217.0
                ],
                [
                    1121.0,
                    217.0
                ],
                [
                    1121.0,
                    321.0
                ],
                [
                    136.0,
                    321.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In this document, the ResponseCode as defined in Annex A is interpreted by the EVCC as follows.",
            "block_bbox": [
                136,
                343,
                1049,
                369
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
