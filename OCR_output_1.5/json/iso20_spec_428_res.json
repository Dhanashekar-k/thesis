        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1975] After receiving the CertificateInstallationReq, if the data required for the CertificateInstallationRes is available and no additional contract certificate chains are available, the SECC shall respond with a CertificateInstallationRes with EVSEProcessing set to \"Finished\" and RemainingContractCertificateChains set to \"0\" within V2G_SECC_Msg_Performance_Time according to Table 215. The next allowed request shall be AuthorizationReq and the V2G_SECC_Sequence_Timeout is set according to Table 215.",
            "block_bbox": [
                135,
                830,
                1123,
                1014
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
