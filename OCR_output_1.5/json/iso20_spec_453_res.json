        {
            "block_label": "text",
            "block_content": "If a certificate requester needs any of these optional fields/parameters/attributes/data types to be included, the requester will need to work with its CA to include those fields/parameters/attributes/data types in the certificate chain. It is out of the scope of this document to define the methodologies for the certificate requester to indicate to the CA whether a particular optional field/parameter/attribute/data type should be included or not.",
            "block_bbox": [
