        },
        {
            "block_label": "text",
            "block_content": "Decentralizing the charging infrastructure and operating it in a PE is an essential element of this document. Whether the implementation of this document is also worthwhile in a PE depends on whether the production and operating costs are lower than those for public are.",
            "block_bbox": [
                135,
                1208,
                1122,
                1289
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    135.0,
