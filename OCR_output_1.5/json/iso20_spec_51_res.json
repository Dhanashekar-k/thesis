                [
                    70.0,
                    1434.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If the CSO desires to secure access to their WLAN for EV-EVSE charging communications, the WLAN AP (see ISO 15118-8 for details) operated by that CSO shall implement all specifications in this subclause and the subclauses within.",
            "block_bbox": [
                253,
                1407,
                1054,
                1485
            ],
            "block_id": 16,
            "block_order": 16,
            "group_id": 16,
            "block_polygon_points": [
                [
                    253.0,
                    1407.0
                ],
                [
                    1054.0,
                    1407.0
                ],
                [
                    1054.0,
                    1485.0
                ],
                [
                    253.0,
                    1485.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 1 It is not mandatory for CSO to support these security mechanisms.",
            "block_bbox": [
