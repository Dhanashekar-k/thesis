        {
            "block_label": "text",
            "block_content": "[V2G20-2084] The <SECCID> shall be interpreted as case-insensitive, i.e. \"DE-8AA-S-00003C4D557878675645330967543476-2\" is exactly the same ID as \"de-8aA-S-00003C4d557878675645330967543476-2\".",
            "block_bbox": [
                137,
                167,
                1118,
                245
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
                    137.0,
                    167.0
                ],
                [
                    1118.0,
                    167.0
                ],
                [
                    1118.0,
                    245.0
                ],
                [
                    137.0,
                    245.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The hyphen (\"-\") is simply used as a separator between the elements <Country Code>, <EVSE Operator ID>, <ID Type>, <ControllerID> and <Check Digit>.",
            "block_bbox": [
                137,
                269,
                1121,
                323
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
