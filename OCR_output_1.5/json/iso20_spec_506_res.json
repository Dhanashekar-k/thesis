                ],
                [
                    136.0,
                    399.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2085] Within 15118-20 the following country codes have a fixed meaning:\n- ZZ-0-... = Any <SECCID> starting with this prefix is reserved and shall be considered as zero or as \"undefined\".",
            "block_bbox": [
                137,
                419,
                1119,
                506
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
