            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1016] The TimeAnchor of a PowerScheduleType element shall define the point in time when the first PowerScheduleEntry element starts to be active.",
            "block_bbox": [
                139,
                672,
                1119,
                725
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "block_polygon_points": [
                [
