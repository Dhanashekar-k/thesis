        },
        {
            "block_label": "text",
            "block_content": "An EVCC currently supports DIN SPEC 70121 and now wants to support ISO 15118-20 (this document) as well. Since DIN SPEC 70121 only offers the minimum feature set, implementing even the most minimal feature set of ISO 15118-20 for DC will suffice.",
            "block_bbox": [
                291,
                850,
                1120,
                920
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
