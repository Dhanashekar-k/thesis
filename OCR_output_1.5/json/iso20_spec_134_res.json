                    926.0
                ],
                [
                    1122.0,
                    1040.0
                ],
                [
                    291.0,
                    1040.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An EVCC currently supports AC & PnC according to ISO 15118-2 and now wants to support BPT/DC according to ISO 15118-20 (this document). The EVCC will transmit a supportedAppProtocolReq with two entries. One entry uses the namespace \"urn:iso:15118:2:2013:MsgDef\" while the other one uses \"urn:iso:std:iso:15118:-20:DC\". Since it becomes clear to the SECC from the namespace \"urn:iso:std:iso:15118:-20:DC\" that the EVCC only supports DC according to (this document), an AC SECC will select ISO 15118-2, while a DC SECC will select this document.",
            "block_bbox": [
                290,
                1046,
                1122,
                1186
            ],
            "block_id": 14,
            "block_order": 14,
            "group_id": 14,
