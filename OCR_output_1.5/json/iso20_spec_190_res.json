        {
            "block_label": "text",
            "block_content": "The SECC shall not terminate the charging session only for the reason that an EVSETargetFrequency has not been achieved, as the frequency cannot be attributed to the EV's behavior.",
            "block_bbox": [
                315,
                606,
                1118,
                682
            ],
            "block_id": 4,
            "block_order": 2,
            "group_id": 4,
            "block_polygon_points": [
