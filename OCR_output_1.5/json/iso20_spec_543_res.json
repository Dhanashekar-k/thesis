                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "H.5 Offline contract certificate installation",
            "block_bbox": [
                68,
                425,
                549,
                453
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
