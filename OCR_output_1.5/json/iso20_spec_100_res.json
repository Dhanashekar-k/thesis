        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2313] Each V2G entity shall be able to verify XML signatures as specified in Table 17.",
            "block_bbox": [
                139,
                402,
                1064,
                431
            ],
            "block_id": 3,
            "block_order": 1,
            "group_id": 3,
            "block_polygon_points": [
                [
