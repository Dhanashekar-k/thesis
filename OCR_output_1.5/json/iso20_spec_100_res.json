                [
                    136.0,
                    935.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 2 This means that when the configuration in [V2G20-2320] indicates usage of algorithm defined in [V2G20-2674], the V2G entity can use keys from appropriate certificate (as specified in Table 17) based on algorithm defined in [V2G20-2674]. Similarly, when the configuration in [V2G20-2320] indicates usage of algorithm defined in [V2G20-2319], the V2G entity can use keys from appropriate certificate (as specified in Table 17) based on algorithm defined in [V2G20-2319].",
            "block_bbox": [
