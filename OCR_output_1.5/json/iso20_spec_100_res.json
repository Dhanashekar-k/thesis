                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2699] When generating or verifying the XML signatures, each V2G entity shall utilize the public/private key associated with the appropriate certificate (as specified in Table 17) that uses the algorithm as indicated by the configuration in [V2G20-2320].",
            "block_bbox": [
                136,
                853,
                1121,
                935
            ],
            "block_id": 8,
            "block_order": 6,
            "group_id": 8,
            "block_polygon_points": [
