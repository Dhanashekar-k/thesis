                [
                    137.0,
                    760.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 1 The key in the extension \"subjectAltKey\" is encoded for use only in ECDH algorithm. It cannot be used to verify signatures using the Ed448 algorithm.",
            "block_bbox": [
                137,
                782,
                1120,
                832
            ],
            "block_id": 7,
            "block_order": 5,
            "group_id": 7,
            "block_polygon_points": [
