                    431.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2477] Each V2G entity generating XML signatures shall utilize the private key associated with the \"subjectKeyInfo\" parameter of the appropriate certificate, as specified in Table 17, to generate the XML signatures.",
            "block_bbox": [
                138,
                452,
                1120,
                532
            ],
            "block_id": 4,
            "block_order": 2,
            "group_id": 4,
            "block_polygon_points": [
                [
                    138.0,
                    452.0
                ],
                [
                    1120.0,
                    452.0
                ],
                [
                    1120.0,
                    532.0
                ],
                [
                    138.0,
                    532.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2478] Each V2G entity verifying XML signatures shall utilize the public key included in the \"subjectPublicKeyInfo\" parameter of the appropriate certificate, as specified in Table 17, to verify the XML signatures.",
            "block_bbox": [
                138,
                553,
                1120,
                633
            ],
            "block_id": 5,
            "block_order": 3,
            "group_id": 5,
            "block_polygon_points": [
