        {
            "block_label": "table",
            "block_content": "<table><tr><td>Description</td><td>Security</td><td>Transport protocol</td></tr><tr><td>Byte no. SDP request message</td><td>1</td><td>2</td></tr><tr><td>Byte no. SDP response message</td><td>19</td><td>20</td></tr><tr><td>Applicable values</td><td>0x00 = secured with TLS\\n0x01-0x0F = reserved\\n0x10 = No transport layer security\\n0x11-0xFF = reserved</td><td>0x00 = TCP\\n0x01-0x0F = reserved\\n0x10 = reserved for UDP\\n0x11-0xFF = reserved</td></tr></table>",
