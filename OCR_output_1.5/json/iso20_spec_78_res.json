            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 17 Signature algorithms are listed in the \"signature_algorithms\" and/or \"signature_algorithms_cert\" extension field(s) in the order of preference of the EVCC with the most preferred signature algorithm first.",
