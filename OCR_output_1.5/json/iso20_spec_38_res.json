        {
            "block_label": "text",
            "block_content": "[V2G20-2336] A PE certificate chain shall not be signed or cross-signed by any CA under a V2G root CA or an eMSP root CA or an OEM root CA. Similarly, PE certificate chain shall not be signed or cross-signed by any V2G root CA or eMSP root CA or OEM root CA.",
            "block_bbox": [
