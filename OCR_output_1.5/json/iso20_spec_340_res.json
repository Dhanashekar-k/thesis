        {
            "block_label": "table",
            "block_content": "<table><tr><td>Element name</td><td>Type</td><td>Semantics</td></tr><tr><td>EVMinimumChargePower</td><td>complexType:RationalNumberTyperefer to 8.3.5.3.8</td><td>Optional:Minimum charge power allowed by the EV.</td></tr><tr><td>EVMaximumChargeCurrent</td><td>complexType:RationalNumberTyperefer to 8.3.5.3.8</td><td>Optional:Maximum charge current allowed by the EV.</td></tr><tr><td>EVMaximumVoltage</td><td>complexType:RationalNumberTyperefer to 8.3.5.3.8</td><td>Optional:Maximum voltage allowed by the EV.</td></tr><tr><td>EVMinimumVoltage</td><td>complexType:RationalNumberTyperefer to 8.3.5.3.8</td><td>Optional:Minimum voltage allowed by the EV.</td></tr></table>",
            "block_bbox": [
