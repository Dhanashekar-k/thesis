        {
            "block_label": "text",
            "block_content": "RemainingContractCertificateChains to the minimum of the number of contract certificates available at the SECC minus one and the value given by MaximumContractCertificateChains in CertificateInstallationReq minus one.",
            "block_bbox": [
                255,
                168,
