        {
            "block_label": "paragraph_title",
            "block_content": "8.3.4.1.3 V2G session pausing",
            "block_bbox": [
                69,
                353,
                392,
                382
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
