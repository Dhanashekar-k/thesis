                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1842] In dynamic control mode, the EVCC shall only request a pause period if triggered by the SECC according to [V2G20-1850].",
            "block_bbox": [
                68,
                1162,
                1052,
                1216
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
