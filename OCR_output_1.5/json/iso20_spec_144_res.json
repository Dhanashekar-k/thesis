        {
            "block_label": "text",
            "block_content": "[V2G20-747] The header of any message sent by the EVCC during an active V2G communication session shall include the SessionID value returned by the SECC in the response to the SessionSetupReq initiating the currently active V2G communication session.",
            "block_bbox": [
                136,
                167,
                1121,
                247
