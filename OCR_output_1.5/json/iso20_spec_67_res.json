                    71.0,
                    342.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If the EVCC offers and the private SECC chooses a named group and signature algorithm based on curves as defined by [V2G20-2319] (as per the configurable mechanism as defined by [V2G20-2320]), the OCSP certificate chain(s) provided by the private SECC in the \"ServerHello\" message shall be based on profiles as defined in B.9.2.",
            "block_bbox": [
                249,
                314,
                1054,
                444
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    249.0,
                    314.0
                ],
                [
                    1054.0,
                    314.0
                ],
                [
                    1054.0,
                    444.0
                ],
                [
                    249.0,
                    444.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 19 In these cases, the OCSP responses are signed using signature algorithm based on curves as defined by [V2G20-2319].",
            "block_bbox": [
                69,
                467,
                1053,
                517
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    69.0,
                    467.0
                ],
                [
                    1053.0,
                    467.0
                ],
                [
                    1053.0,
                    517.0
                ],
                [
                    69.0,
                    517.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1021] The validity period of the OCSP response provided by the SECC shall be limited to one week.",
            "block_bbox": [
                71,
                537,
                1053,
                590
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    71.0,
                    537.0
                ],
                [
                    1053.0,
                    537.0
                ],
                [
                    1053.0,
                    590.0
                ],
                [
                    71.0,
                    590.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 20 If cached, each OCSP response can be updated at least once a week.",
            "block_bbox": [
                69,
                612,
                744,
                639
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    69.0,
                    612.0
                ],
                [
                    744.0,
                    612.0
                ],
                [
                    744.0,
                    639.0
                ],
                [
                    69.0,
                    639.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The validity period is left to the discretion of the OCSP responder. The OCSP response validity cannot be longer than as specified by [V2G20-1021], but it can be shorter than specified by [V2G20-1021].",
            "block_bbox": [
                68,
                660,
                1053,
                716
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
                    68.0,
                    660.0
                ],
                [
                    1053.0,
                    660.0
                ],
                [
                    1053.0,
                    716.0
                ],
                [
                    68.0,
                    716.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In the case where the OCSP response for a certificate was not signed by the issuing CA of the certificate (V2G root CA, CSO sub-CA1, CSO sub-CA2 or any cross-certified CA), each OCSP response shall contain the associated OCSP responder's certificate chain including any necessary cross-certificates and each certificate in the chain (except the OCSP signer certificate) shall include the AuthorityInfoAccess extension field.",
            "block_bbox": [
                253,
                737,
                1054,
                892
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    253.0,
                    737.0
                ],
                [
                    1054.0,
                    737.0
                ],
                [
                    1054.0,
                    892.0
                ],
                [
                    253.0,
                    892.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 21 As defined in IETF RFC (as updated by IETF RFC 8954), an OCSP responder might either be the sub-CA itself, or it might be an entity which is directly signed by the corresponding sub-CA/root CA using a key pair with a special extended key usage flag in the certificate.",
            "block_bbox": [
                67,
                914,
                1054,
                989
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
                    67.0,
                    914.0
                ],
                [
                    1054.0,
                    914.0
                ],
                [
                    1054.0,
                    989.0
                ],
                [
                    67.0,
                    989.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2394] Each of the OCSP responses provided by the public SECC in the \"ServerHello\" message shall be signed by a certificate derived from one of the V2G root CA certificates supported by the EVCC (EVCC provided a list of the V2G certificates via [V2G20-1006]).",
            "block_bbox": [
                68,
                1009,
                1053,
                1115
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
                [
                    68.0,
                    1009.0
                ],
                [
                    1053.0,
                    1009.0
                ],
                [
                    1053.0,
                    1115.0
                ],
                [
                    68.0,
                    1115.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2395] Each of the OCSP responses provided by the private SECC in the \"ServerHello\" message shall be signed by a certificate derived from one of the PE private root CA certificates supported by the EVCC (EVCC provided a list of the V2G certificates via [V2G20-1006] or it received from the private SECC via [V2G20-2385]).",
            "block_bbox": [
                68,
                1135,
                1054,
                1243
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    68.0,
                    1135.0
                ],
                [
                    1054.0,
                    1135.0
                ],
                [
                    1054.0,
                    1243.0
                ],
                [
                    68.0,
                    1243.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2396] If the OCSP response for a particular certificate is not available from an OCSP responder that has a certificate derived from one of the V2G root CA certificates supported by the EVCC (EVCC provided a list of the V2G certificates via [V2G20-1006]), the public SECC shall omit providing OCSP response for that certificate in the \"ServerHello\" message.",
            "block_bbox": [
                68,
                1263,
                1054,
                1395
            ],
            "block_id": 13,
            "block_order": 13,
            "group_id": 13,
            "block_polygon_points": [
