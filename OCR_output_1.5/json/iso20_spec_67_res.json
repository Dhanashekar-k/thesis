        {
            "block_label": "paragraph_title",
            "block_content": "[V2G20-2393]",
            "block_bbox": [
                71,
                314,
                219,
                342
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
