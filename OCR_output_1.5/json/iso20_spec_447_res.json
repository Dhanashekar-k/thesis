        {
            "block_label": "text",
            "block_content": "– \"V2G_CI_CommonTypes\": defines the common types used by all defined messages (except SAP). The XSD file can be downloaded from:\nhttps://standards.iso.org/iso/15118/-20/ed-1/en/V2G_CI_CommonTypes.xsd;",
            "block_bbox": [
