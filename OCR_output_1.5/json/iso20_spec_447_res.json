        {
            "block_label": "text",
            "block_content": "– \"V2G_CI_AppProtocol\": defines the protocol handshake (SAP) messages. The XSD file can be downloaded from:\nhttps://standards.iso.org/iso/15118/-20/ed-1/en/V2G_CI_AppProtocol.xsd;",
            "block_bbox": [
