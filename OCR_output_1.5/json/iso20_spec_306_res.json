        {
            "block_label": "table",
            "block_content": "<table><tr><td>Element name</td><td>Type</td><td>Semantics</td></tr><tr><td>EVMaximumChargePower_L2</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Maximum power supported by the EV on phase L2 (as defined in 8.3.5.2.2)</td></tr><tr><td>EVMaximumChargePower_L3</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Maximum power supported by the EV on phase L3 (as defined in 8.3.5.2.2)</td></tr><tr><td>EVMinimumChargePower</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Any target power between this level and zero may, for technical reasons, result in a drop of the actual power to zero watts.</td></tr><tr><td>EVMinimumChargePower_L2</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Any target power on phase L2 between this level and zero may, for technical reasons, result in a drop of the actual power to zero watts.</td></tr><tr><td>EVMinimumChargePower_L3</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Any target power on phase L3 between this level and zero may, for technical reasons, result in a drop of the actual power to zero watts.</td></tr></table>",
            "block_bbox": [
