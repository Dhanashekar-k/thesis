            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE If the EVCC only sent the base elements in case of ThreePhase energy transfer in the ChargeParameterDiscoveryReq, it implicitly states that it is only capable of symmetric energy transfer. In case it sends the phase specific elements with the suffixes L2 and L3, it implicitly states, that it is capable of asymmetric energy transfer.",
            "block_bbox": [
                136,
                1117,
                1122,
                1215
            ],
            "block_id": 4,
            "block_order": 3,
