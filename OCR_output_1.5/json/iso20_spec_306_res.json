        {
            "block_label": "text",
            "block_content": "[V2G20-1820] In the context of ThreePhase energy transfer, if an EV is only capable of symmetric energy transfer, it shall during the ChargeParameterDiscoveryReq only communicate an EVMaximumChargePower and EVMimimumChargePower, which represent the sum of all three phases in accordance to requirement [V2G20-1814].",
            "block_bbox": [
                138,
                862,
                1119,
                970
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "block_polygon_points": [
                [
                    138.0,
                    862.0
                ],
                [
                    1119.0,
                    862.0
                ],
                [
                    1119.0,
                    970.0
                ],
                [
                    138.0,
                    970.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1821] In the context of ThreePhase energy transfer, if an EV is capable of asymmetric energy transfer, it shall during the ChargeParameterDiscoveryReq communicate an EVMaximumChargePower and EVMinimumChargePower with phase specific power values (see 8.3.5.2.2).",
            "block_bbox": [
                137,
                989,
                1121,
                1096
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "block_polygon_points": [
