        {
            "block_label": "paragraph_title",
            "block_content": "7.3.1 General",
            "block_bbox": [
                208,
                706,
                369,
                733
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
                    208.0,
