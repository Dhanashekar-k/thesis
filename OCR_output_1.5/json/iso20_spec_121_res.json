                    1053.0,
                    248.0
                ],
                [
                    67.0,
                    248.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "After the EVCC received the IP address and the port number of the SECC, it can establish a transport layer connection to the SECC (refer to 7.3.4).",
            "block_bbox": [
