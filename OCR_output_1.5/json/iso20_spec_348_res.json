            "block_label": "table",
            "block_content": "<table><tr><td>Element name</td><td>Type</td><td>Semantics</td></tr><tr><td>EVMaximumChargePower</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Maximum charge power allowed by the EV.</td></tr><tr><td>EVMinimumChargePower</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Minimum charge power allowed by the EV.</td></tr><tr><td>EVMaximumChargeCurrent</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Maximum charge current allowed by the EV.</td></tr><tr><td>EVMaximumVoltage</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Maximum voltage allowed by the EV.</td></tr><tr><td>EVMinimumVoltage</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Minimum voltage allowed by the EV.</td></tr><tr><td>EVMaximumDischargePower</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Maximum discharge power allowed by the EV.</td></tr><tr><td>EVMinimumDischargePower</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Minimum discharge power allowed by the EV.</td></tr><tr><td>EVMaximumDischargeCurrent</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Maximum discharge current allowed by the EV.</td></tr><tr><td>EVMaximumV2XEnergyRequest</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Energy which may be charged until the PresentSOC has left the range dedicated for cycling activity. A negative value indicates that PresentSOC is above the V2X range.</td></tr><tr><td>EVMinimumV2XEnergyRequest</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Energy which needs to be charged until the PresentSOC enters the range dedicated for cycling activity. A positive value indicates that PresentSOC is below the V2X range.</td></tr></table>",
