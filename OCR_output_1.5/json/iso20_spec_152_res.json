            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2637] The EVCC should securely store the hash generated by [V2G20-2558] until it is used per [V2G20-2638].",
            "block_bbox": [
                138,
                594,
                1120,
                649
