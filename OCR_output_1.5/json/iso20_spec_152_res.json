            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2558] Whenever the EVCC performs the \"Full Handshake\" (as described in 7.7.3.5) to setup a TLS session (as described in 7.7.3.3, 7.7.3.4 and 7.7.3.5), it shall calculate a new session binding by following [V2G20-2635].",
            "block_bbox": [
                138,
                494,
                1120,
                573
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
