        {
            "block_label": "paragraph_title",
            "block_content": "7.3.2.1 Certificate structure",
            "block_bbox": [
                218,
                960,
                540,
                988
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
