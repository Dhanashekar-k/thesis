        },
        {
            "block_label": "paragraph_title",
            "block_content": "7.9.2.5.2.2.1 Common requirements for encryption of 521-bit and 448-bit contract certificate private keys for EVCC without TPM 2.0",
            "block_bbox": [
                68,
                482,
                1029,
                534
            ],
            "block_id": 5,
            "block_order": 3,
            "group_id": 5,
            "block_polygon_points": [
                [
                    68.0,
