                    1122.0,
                    421.0
                ],
                [
                    1122.0,
                    553.0
                ],
                [
                    135.0,
                    553.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2020] If ServiceName = DC or DC_BPT in Table 204 is used, and the PowerDeliveryReq received has ChargeProgress = \"Stop\", the next allowed request shall be DC_WeldingDetectionReq and the V2G_SECC_Sequence_Timeout is set according to Table 217.",
            "block_bbox": [
                136,
                574,
                1123,
                679
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    136.0,
                    574.0
