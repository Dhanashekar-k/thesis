                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1630] After receiving the DC_WeldingDetectionReq with EVProcessing set to \"Ongoing\", the SECC shall respond with a DC_WeldingDetectionRes within V2G_SECC_Msg_Performance_Time according to Table 217. The next allowed request shall be DC_WeldingDetectionReq and the V2G_SECC_Sequence_Timeout is set according to Table 217.",
            "block_bbox": [
                136,
                701,
                1123,
                833
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
