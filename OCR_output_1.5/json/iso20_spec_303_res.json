        {
            "block_label": "text",
            "block_content": "[V2G20-2162] If more than one ScheduleTuple containing PriceLevelSchedule is sent to the EVCC, they shall have the same NumberOfPriceLevels and priceLevels inside different ScheduleTupleless shall correspond to the same energy price.",
            "block_bbox": [
                69,
                167,
                1052,
                246
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
