                    246.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2163] The TimeAnchor of a PriceLevelScheduleType element shall define a time that either is the present or some point in the near past.",
            "block_bbox": [
                70,
                269,
                1053,
                322
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
