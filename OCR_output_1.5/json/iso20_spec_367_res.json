        {
            "block_label": "text",
            "block_content": "Two control modes are available. Basically, a distinction is made between two main situations: (a) the EVCC is in charge of ensuring the mobility needs (scheduled control mode), or (b) ensuring the mobility needs is delegated to an off-board system (dynamic control mode).",
            "block_bbox": [
                68,
                1082,
                1053,
                1159
            ],
            "block_id": 14,
            "block_order": 14,
            "group_id": 14,
            "block_polygon_points": [
