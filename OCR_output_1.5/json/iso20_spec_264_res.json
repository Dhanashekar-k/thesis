        {
            "block_label": "text",
            "block_content": "NOTE 2 The EVCC assumes that the hard capability limits communicated in an EVSEMaximumChargePower [L2,L3] value always will overrule any matching values provided within a PowerSchedule.",
            "block_bbox": [
                137,
                167,
                1120,
                217
            ],
            "block_id": 1,
