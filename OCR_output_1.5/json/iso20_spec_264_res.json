                [
                    135.0,
                    846.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 4 The EVCC can request an update of tariff information by applying the schedule renegotiation process at any time during the charging loop.",
            "block_bbox": [
                136,
                867,
                1121,
                918
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
