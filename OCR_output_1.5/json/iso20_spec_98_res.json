        {
            "block_label": "text",
            "block_content": "[V2G20-1449] The parts which are signed in the XML-based messages shall be encoded as EXI schema-informed fragment. To encode the signature header, the XML signature schema shall be used as entry point, instead of the schema defined by this document.",
            "block_bbox": [
                135,
                370,
