            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2473] Each message, that needs the XML signature framework shall use the value \"http://www.w3.org/2001/04/xmldsig-more#ecdsa-sha512\" as algorithm attribute within the SignatureMethod element, if the algorithm defined in [V2G20-2674] shall be used according to the configuration in [V2G20-2320]. The certificate whose private key is used for signing the message shall be based on the algorithm defined in [V2G20-2674].",
            "block_bbox": [
