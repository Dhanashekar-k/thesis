        {
            "block_label": "text",
            "block_content": "Contract certificate is bound to an EMAID and used in XML signature to authorize the EV for charging. The contract certificate's attributes, like signature and validity period, can be verified even if the SECC is offline, given that the corresponding root CA certificate is stored locally on the SECC. For checking the revocation status via OCSP, the SECC needs to be online. The contract binding is handled as follows.",
            "block_bbox": [
                136,
                468,
                1121,
                573
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
