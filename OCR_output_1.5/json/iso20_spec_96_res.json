        {
            "block_label": "text",
            "block_content": "NOTE 1 This document uses different ECC algorithms, signature algorithms, hash algorithms, etc. as compared to the examples in ISO 15118-2:2014. Hence the examples in ISO 15118-2:2014, do not directly apply to this document, but are very close.",
            "block_bbox": [
                136,
                1033,
                1120,
                1106
            ],
            "block_id": 13,
