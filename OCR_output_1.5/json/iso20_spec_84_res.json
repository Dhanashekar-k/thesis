                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "7.7.3.8 TLS session termination",
            "block_bbox": [
                219,
                1447,
                579,
                1475
            ],
            "block_id": 15,
            "block_order": 15,
            "group_id": 15,
            "block_polygon_points": [
