        {
            "block_label": "header",
            "block_content": "ISO 15118-20:2022(E)",
            "block_bbox": [
                866,
                69,
                1118,
                96
            ],
            "block_id": 0,
            "block_order": null,
            "group_id": 0,
            "block_polygon_points": [
                [
                    866.0,
