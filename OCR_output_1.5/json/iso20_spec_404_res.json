                [
                    136.0,
                    767.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2216] The message \"AuthorizationRes\" shall contain the ResponseCode \"WARNING_ChallengeInvalid\" if the challenge response contained in the AuthorizationReq message, in attribute GenChallenge, is not valid versus the GenChallenge provided in AuthorizationSetupRes.",
