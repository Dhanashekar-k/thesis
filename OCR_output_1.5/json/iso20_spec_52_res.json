                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2244] The V2G entity shall use EAP extension EAP-TLS, as specified by IETF RFC 5216. TLS 1.3 shall be used for EAP-TLS.",
            "block_bbox": [
                137,
                1321,
                1119,
                1375
            ],
            "block_id": 16,
            "block_order": 16,
            "group_id": 16,
            "block_polygon_points": [
