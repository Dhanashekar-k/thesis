                    96.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2238] If the OEM wants their EVs to access CSO's secure WLAN for EV-EVSE charging communications, the WLAN STA (see ISO 15118-8 for details) in the OEM's EV shall implement all specifications in this subclause and the subclauses within.",
            "block_bbox": [
                137,
                168,
                1119,
                246
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
                    137.0,
                    168.0
                ],
                [
                    1119.0,
                    168.0
                ],
                [
                    1119.0,
                    246.0
                ],
                [
                    137.0,
                    246.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 2 It is not mandatory for the OEM to support these security mechanisms.",
            "block_bbox": [
                137,
                269,
                844,
                294
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    137.0,
                    269.0
                ],
                [
                    844.0,
                    269.0
                ],
                [
                    844.0,
                    294.0
                ],
                [
                    137.0,
                    294.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2239] It is up to the CSOs discretion whether to allow an EV that does not support the required security for WLAN to access the CSO's secure WLAN for EV-EVSE charging communications.",
            "block_bbox": [
                138,
                317,
                1120,
                393
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    138.0,
                    317.0
                ],
                [
                    1120.0,
                    317.0
                ],
                [
                    1120.0,
                    393.0
                ],
                [
                    138.0,
                    393.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 3 The CSO is free to decline access to such EVs to access the CSO’s WLAN.",
            "block_bbox": [
                137,
                417,
                846,
                442
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    137.0,
                    417.0
                ],
                [
                    846.0,
                    417.0
                ],
                [
                    846.0,
                    442.0
                ],
                [
                    137.0,
                    442.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 4 If the CSO goes through the effort of securing their WLAN for EV-EVSE charging communications, the CSO will likely not accept insecure connections to its WLAN.",
            "block_bbox": [
                137,
                465,
                1119,
                514
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    137.0,
                    465.0
                ],
                [
                    1119.0,
                    465.0
                ],
                [
                    1119.0,
                    514.0
                ],
                [
                    137.0,
                    514.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2240] It is up to the OEM's discretion whether to allow an EV that supports security for WLAN to access a CSO's unsecured WLAN for EV-EVSE charging communications.",
            "block_bbox": [
                138,
                536,
                1120,
                589
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    138.0,
                    536.0
                ],
                [
                    1120.0,
                    536.0
                ],
                [
                    1120.0,
                    589.0
                ],
                [
                    138.0,
                    589.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 5 The OEM (EV) is free to decline connections to insecure WLAN.",
            "block_bbox": [
                137,
                611,
                778,
                636
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    137.0,
                    611.0
                ],
                [
                    778.0,
                    611.0
                ],
                [
                    778.0,
                    636.0
                ],
                [
                    137.0,
                    636.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "7.5.1.1 Applicable RFCs",
            "block_bbox": [
                219,
                656,
                497,
                684
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
                    219.0,
                    656.0
                ],
                [
                    497.0,
                    656.0
                ],
                [
                    497.0,
                    684.0
                ],
                [
                    219.0,
                    684.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The security on the data link layer is ensured through the use of IEEE 802.1X. It is part of the IEEE 802.11-2020 group of network protocols. IEEE 802.1X defines the encapsulation of the extensible authentication protocol (EAP) via IEEE 802.11-2020. EAP is an authentication framework that supports multiple authentication methods. EAP works directly over data link layers (IEEE 802) without the need for IP. EAP encapsulation can be used for both wired and wireless media. This document strongly recommends the use of IEEE 802.1X for connections utilizing wireless media.",
            "block_bbox": [
                136,
                706,
                1121,
                862
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    136.0,
                    706.0
                ],
                [
                    1121.0,
                    706.0
                ],
                [
                    1121.0,
                    862.0
                ],
                [
                    136.0,
                    862.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2241] A V2G entity shall implement IEEE 802.1X.",
            "block_bbox": [
                138,
                884,
                731,
                912
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
                    138.0,
                    884.0
                ],
                [
                    731.0,
                    884.0
                ],
                [
                    731.0,
                    912.0
                ],
                [
                    138.0,
                    912.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 1 These requirements are normally not implemented in the SECC or EVCC. The OEM would normally implement these requirements in the WLAN STA. The CSO/PE operator would normally implement these requirements in the WLAN AP.",
            "block_bbox": [
                136,
                934,
                1120,
                1007
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
                [
                    136.0,
                    934.0
                ],
                [
                    1120.0,
                    934.0
                ],
                [
                    1120.0,
                    1007.0
                ],
                [
                    136.0,
                    1007.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2242] IETF RFC 3748 shall be used as the encapsulation of IEEE 802.1X.",
            "block_bbox": [
                138,
                1028,
                944,
                1056
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    138.0,
                    1028.0
                ],
                [
                    944.0,
                    1028.0
                ],
                [
                    944.0,
                    1056.0
                ],
                [
                    138.0,
                    1056.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 2 IETF RFC 3748 has been updated by IETF RFC 5247 and IETF RFC 7057. IETF RFC 5247 has been updated by IETF RFC 8940. All these updates are considered to be included in this document.",
            "block_bbox": [
                137,
                1078,
                1119,
                1129
            ],
            "block_id": 13,
            "block_order": 13,
            "group_id": 13,
            "block_polygon_points": [
                [
                    137.0,
                    1078.0
                ],
                [
                    1119.0,
                    1078.0
                ],
                [
                    1119.0,
                    1129.0
                ],
                [
                    137.0,
                    1129.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2243] Remote authentication dial-in user service (RADIUS) as specified by IETF RFC 3579 shall be used as \"pass-through peer\" implementation of IETF RFC 3748 by the CSO/PE operator.",
            "block_bbox": [
                138,
                1150,
                1120,
                1229
            ],
            "block_id": 14,
            "block_order": 14,
            "group_id": 14,
            "block_polygon_points": [
                [
                    138.0,
                    1150.0
                ],
                [
                    1120.0,
                    1150.0
                ],
                [
                    1120.0,
                    1229.0
                ],
                [
                    138.0,
                    1229.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 3 IETF RFC 3579 has been updated by IETF RFC 5080. These updates are considered to be included in this document.",
            "block_bbox": [
                137,
                1251,
                1120,
                1299
            ],
            "block_id": 15,
            "block_order": 15,
            "group_id": 15,
            "block_polygon_points": [
                [
                    137.0,
                    1251.0
                ],
                [
                    1120.0,
                    1251.0
                ],
                [
                    1120.0,
