        {
            "block_label": "table",
            "block_content": "<table><tr><td rowspan=\"2\" colspan=\"2\">ISO 15118-2 certificate profiles</td><td colspan=\"4\">Private SECC/private environment</td></tr><tr><td>PE private root CA Root</td><td>PE sub-CA1 Sub (optional)</td><td>PE sub-CA2 Sub (optional)</td><td>PE certification Leaf</td></tr><tr><td rowspan=\"3\">SignatureAlg orithm</td><td>AlgorithmIdentifier</td><td>✗</td><td>✗</td><td>✗</td><td>✗</td></tr><tr><td>algorithm</td><td>✗ id-Ed448</td><td>✗ id-Ed448</td><td>✗ id-Ed448</td><td>✗ id-Ed448</td></tr><tr><td>parameters</td><td>-</td><td>-</td><td>-</td><td>-</td></tr><tr><td colspan=\"2\">SignatureValue</td><td>(Raw BIT STRING)</td><td>(Raw BIT STRING)</td><td>(Raw BIT STRING)</td><td>(Raw BIT STRING)</td></tr></table>",
