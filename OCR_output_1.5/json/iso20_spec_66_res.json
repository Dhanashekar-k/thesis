        {
            "block_label": "text",
            "block_content": "[V2G20-2388] Since the EVCC used the \"status_request\" extension to request OCSP response for the certificate chain sent by the public SECC, it shall include an OCSP response for each certificate in the certificate chain sent by the public SECC in the \"ServerHello\" message. Refer to IETF RFC 6960 (as updated by IETF RFC 8954) and IETF RFC 8446 for further details.",
            "block_bbox": [
                135,
                650,
                1122,
                780
            ],
            "block_id": 5,
