                    1121.0,
                    268.0
                ],
                [
                    1121.0,
                    372.0
                ],
                [
                    135.0,
                    372.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2386] If the EVCC offers and private SECC chooses a named group and signature algorithm based on curves as defined by [V2G20-2674] (as per the configurable mechanism as defined by [V2G20-2320]), the PE certificate chain provided by the private SECC in the \"ServerHello\" message shall be based on profiles as defined in B.10.1.",
            "block_bbox": [
                135,
                395,
                1122,
                502
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
