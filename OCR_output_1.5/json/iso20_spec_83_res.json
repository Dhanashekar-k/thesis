                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 15 This ensures that the existing TLS session is not extended indefinitely. Indefinite TLS session extension can lead to security risks like TLS session continuation long (604 800 s (7 days)) after certificate expiration or revocation, etc.",
            "block_bbox": [
                68,
                1300,
                1054,
