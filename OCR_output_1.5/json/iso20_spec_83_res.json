    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "ISO 15118-20:2022(E)",
            "block_bbox": [
                70,
                68,
                322,
                95
            ],
            "block_id": 0,
            "block_order": null,
            "group_id": 0,
            "block_polygon_points": [
                [
