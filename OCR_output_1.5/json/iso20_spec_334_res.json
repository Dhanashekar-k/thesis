        {
            "block_label": "table",
            "block_content": "<table><tr><td>Element name</td><td>Type</td><td>Semantics</td></tr><tr><td>EVSETargetActivePower</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Target active power requested by the EVSE.</td></tr><tr><td>EVSETargetActivePower_L2</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Target active power requested by the EVSE on phase L2 (as defined in 8.3.5.2.2).</td></tr><tr><td>EVSETargetActivePower_L3</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Target active power requested by the EVSE on phase L3 (as defined in 8.3.5.2.2).</td></tr><tr><td>EVSETargetReactivePower</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Target reactive power requested by the EVSE.</td></tr><tr><td>EVSETargetReactivePower_L2</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Target reactive power requested by the EVSE on phase L2 (as defined in 8.3.5.2.2).</td></tr><tr><td>EVSETargetReactivePower_L3</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Target reactive power requested by the EVSE on phase L3 (as defined in 8.3.5.2.2).</td></tr><tr><td>EVSEPresentActivePower</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Active power as presently measured by the EVSE. This value is based on the actual voltage and not the EVSENominalVoltage.</td></tr><tr><td>EVSEPresentActivePower_L2</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Active power as presently measured by the EVSE on phase L2 (as defined in 8.3.5.2.2). This value is based on the actual voltage and not the EVSENominalVoltage.</td></tr><tr><td>EVSEPresentActivePower_L3</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Optional: Active power as presently measured by the EVSE on phase L3 (as defined in 8.3.5.2.2). This value is based on the actual voltage and not the EV