        {
            "block_label": "text",
            "block_content": "[V2G20-706] The EVCC shall stop waiting for the pre charging to finish and stop monitoring the V2G_EVCC_DC_PreCharge_Timer when V2G_EVCC_DC_PreCharge_Timer is equal or larger than V2G_EVCC_DC_PreCharge_Timeout. It shall then apply the error handling as defined in 8.6.",
            "block_bbox": [
                135,
                269,
                1121,
                373
            ],
            "block_id": 2,
