        },
        {
            "block_label": "vision_footnote",
            "block_content": "[V2G20-1415] As exception to [V2G20-1034] and [V2G20-1035], the values of the element DischargedEnergyReadingWh shall always be positive numbers.",
            "block_bbox": [
                138,
                979,
                1120,
                1032
            ],
            "block_id": 2,
            "block_order": null,
            "group_id": 2,
            "block_polygon_points": [
                [
                    138.05032348632812,
                    971.9932250976562
                ],
                [
                    1119.373046875,
                    979.0386962890625
                ],
                [
                    1119.0,
