                    448.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-920] After receiving a DC_WeldingDetectionReq message or a SessionStopReq message, the SECC shall wait for a maximum of V2G_SECC_Msg_Performance_Time to measure CP state B.",
            "block_bbox": [
                138,
                472,
                1120,
                548
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    138.0,
