        {
            "block_label": "text",
            "block_content": "[V2G20-2398] A private SECC not supporting PnC can ignore the \"status_request\" extension, and continue as if the EVCC never sent that request. Refer IETF RFC 8446 for further details.",
            "block_bbox": [
                137,
                168,
                1120,
                245
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
                    137.0,
                    168.0
                ],
                [
                    1120.0,
                    168.0
                ],
                [
                    1120.0,
                    245.0
                ],
                [
                    137.0,
                    245.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 22 A private SECC not supporting PnC is allowed to function in an offline mode where it cannot provide OCSP response for its PE certificate chain.",
            "block_bbox": [
                136,
                269,
                1120,
                318
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    136.0,
                    269.0
                ],
                [
                    1120.0,
                    269.0
                ],
                [
                    1120.0,
                    318.0
                ],
                [
                    136.0,
                    318.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A private SECC supporting PnC is required to provide OCSP response for its PE certificate chain.",
            "block_bbox": [
                136,
                340,
                1040,
                368
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
