        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2401] A public SECC shall send a list of all V2G root CA certificate(s) and/or OEM root CA certificate(s) it possesses via the \"certificate_authorities\" extension in the \"CertificateRequest\" message it sends to the EVCC.",
            "block_bbox": [
