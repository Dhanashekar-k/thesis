                ],
                [
                    136.0,
                    584.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 38 It is not in the scope of this document to specify the methodology for the EVCC to contact the OCSP server directly.",
            "block_bbox": [
                137,
                606,
                1120,
                656
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
