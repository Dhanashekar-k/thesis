        {
            "block_label": "text",
            "block_content": "[V2G20-2411] If the OCSP status of any certificate in SECC certificate chain is not provided by the public SECC in the \"ServerHello\", the EVCC may contact the OCSP server listed in the said certificate for the OCSP status of that certificate.",
            "block_bbox": [
                137,
                168,
                1119,
                247
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
                    137.0,
