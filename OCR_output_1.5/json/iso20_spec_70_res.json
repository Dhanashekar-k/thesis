                    1119.0,
                    247.0
                ],
                [
                    137.0,
                    247.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 35 The EVCC can determine that the received certificate chain is linked to a V2G root CA certificate. In that case, the received certificate is a SECC certificate and the EVCC is connected to a public SECC.",
            "block_bbox": [
                136,
                268,
                1120,
                319
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    136.0,
                    268.0
                ],
                [
                    1120.0,
                    268.0
                ],
                [
                    1120.0,
                    319.0
                ],
                [
                    136.0,
                    319.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 36 It is not in the scope of this document to specify the methodology for the EVCC to contact the OCSP server directly.",
            "block_bbox": [
                137,
                339,
                1120,
                389
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
