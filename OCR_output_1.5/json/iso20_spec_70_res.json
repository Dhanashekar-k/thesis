                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If the private SECC provided OCSP status of at least one but not all of the certificates in the PE certificate chain in the \"ServerHello\", the EVCC may contact the OCSP server listed in the said certificate for the OCSP status of that certificate.",
            "block_bbox": [
                309,
                411,
                1121,
                490
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    309.0,
                    411.0
                ],
                [
                    1121.0,
                    411.0
                ],
                [
                    1121.0,
                    490.0
                ],
                [
                    309.0,
                    490.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 37 The EVCC can determine that the received certificate chain is linked to a PE private root CA certificate. In that case, the received certificate is a PE certificate and the EVCC is connected to a private SECC in a private environment.",
            "block_bbox": [
                136,
                511,
                1121,
                584
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    136.0,
                    511.0
                ],
                [
                    1121.0,
                    511.0
                ],
                [
                    1121.0,
