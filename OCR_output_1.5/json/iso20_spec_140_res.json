        {
            "block_label": "text",
            "block_content": "For safety reasons to enter a standby period in DC or WPT, an EV will gradually decrease the current to 0A before sending a PowerDeliveryReq message with ChargeProgress set to \"Standby\".",
            "block_bbox": [
                136,
                396,
