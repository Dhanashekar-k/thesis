        {
            "block_label": "text",
            "block_content": "[V2G20-1538] The previous requirement [V2G20-1537] shall not apply to the first (SessionSetupReq) and the second (ServiceDiscoveryReq) message which is being sent by the EVCC within a newly established charging session.",
            "block_bbox": [
                69,
