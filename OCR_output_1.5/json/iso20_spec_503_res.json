        },
        {
            "block_label": "paragraph_title",
            "block_content": "C.2 Provisioning certificate identifier (PCID)",
            "block_bbox": [
                70,
                746,
                572,
                776
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
