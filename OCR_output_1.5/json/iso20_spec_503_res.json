        {
            "block_label": "text",
            "block_content": "The e-Mobility authentication identifier substitutes the \"e-Mobility account identifier\" from ISO 15118-2 and the \"Contract ID\" from ISO 15118-1.",
            "block_bbox": [
                68,
                467,
                1051,
                521
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
