                ],
                [
                    1051.0,
                    622.0
                ],
                [
                    69.0,
                    622.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2076] The EMAID shall match the requirements as specified in IEC 63119-2.",
            "block_bbox": [
                70,
                644,
                916,
                672
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
