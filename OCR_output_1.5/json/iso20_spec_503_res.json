        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2079] PCID shall be an alphanumeric string with a length of minimum 18 and maximum 255 characters (i.e. A..Z, a..z, 0..9), including a check digit at the end.",
            "block_bbox": [
                70,
                1158,
                1049,
                1212
            ],
            "block_id": 14,
            "block_order": 14,
            "group_id": 14,
            "block_polygon_points": [
                [
                    70.0,
                    1158.0
                ],
                [
                    1049.0,
                    1158.0
                ],
                [
                    1049.0,
                    1212.0
                ],
                [
                    70.0,
                    1212.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 1 Since the user needs to read the PCID and provide it to the eMSP at the time of signing the contract, a larger PCID can be more error prone for registering with the eMSP.",
            "block_bbox": [
                68,
                1233,
                1053,
