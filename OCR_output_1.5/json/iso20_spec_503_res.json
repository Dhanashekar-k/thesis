                    672.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2126] The maximum length of EMAID shall be 255 characters.",
            "block_bbox": [
                70,
                694,
                785,
                722
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
