                ],
                [
                    68.0,
                    521.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2702] Once a V2G communication session has been authorized using a contract certificate, the EMAID and the contract certificate provided in AuthorizationReq shall not change until the said V2G communication session has been terminated.",
            "block_bbox": [
                69,
                542,
                1051,
                622
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    69.0,
                    542.0
                ],
                [
                    1051.0,
