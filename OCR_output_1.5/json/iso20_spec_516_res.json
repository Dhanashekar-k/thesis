            ]
        },
        {
            "block_label": "text",
            "block_content": "- Export hash of master secret from session ticket received to VAS process for comparison.",
            "block_bbox": [
                243,
                773,
                1120,
                799
            ],
            "block_id": 8,
            "block_order": 8,
