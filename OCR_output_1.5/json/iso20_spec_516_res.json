                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "This annex has not been fully reviewed and updated in this document. It will be improved upon in the next edition. The implementers should be careful when reading and designing systems relying on information mentioned here.",
            "block_bbox": [
                137,
                470,
                1121,
                549
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
