        },
        {
            "block_label": "text",
            "block_content": "– The implementation can be achieved for example by inter-process-communication between the VAS and V2G process or an intermediary database.",
            "block_bbox": [
                244,
                823,
                1120,
                874
            ],
            "block_id": 9,
