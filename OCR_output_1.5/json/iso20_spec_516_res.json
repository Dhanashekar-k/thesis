            ]
        },
        {
            "block_label": "text",
            "block_content": "In addition to the cryptographic binding in TLS layer achieved by TLS resumption ticket as described in 7.7.3.7, the application-layer association of a connecting VAS client to existing V2G session in the SECC may be accomplished as follows.",
            "block_bbox": [
                137,
                571,
                1121,
                650
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    137.0,
                    571.0
                ],
                [
                    1121.0,
                    571.0
                ],
                [
                    1121.0,
                    650.0
                ],
                [
                    137.0,
                    650.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "– Comparing fingerprints of the TLS master key contained in the session ticket.",
            "block_bbox": [
                171,
                673,
                940,
                700
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
