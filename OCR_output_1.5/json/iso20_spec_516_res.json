                    171.0,
                    700.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- Export hash of master secret from running TLS sessions to VAS process for comparison.",
            "block_bbox": [
                243,
                723,
                1110,
                750
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
