        {
            "block_label": "paragraph_title",
            "block_content": "7.4 V2G communication states and data link handling",
            "block_bbox": [
                68,
                214,
                616,
                241
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
