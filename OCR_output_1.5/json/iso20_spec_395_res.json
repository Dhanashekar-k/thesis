        {
            "block_label": "text",
            "block_content": "During standby both EV and EVSE contactors are to stay closed. The standby concept is solely used as communication state within this document and therefore is not reflected in related documents, e.g. IEC 61851-1 or IEC 61851-23.",
            "block_bbox": [
                68,
                168,
                1054,
                239
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
