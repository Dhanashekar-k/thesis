            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1386] The SECC shall exit standby, after having received PowerDeliveryReq with ChargeProgress set to \"Start\", \"Stop\", or \"Renegotiate\", by sending a PowerDeliveryRes with ResponseCode set to \"OK\", while V2G_SECC_Sequence_Timer is smaller than V2G_SECC_Sequence_Timeout.",
            "block_bbox": [
                69,
                261,
                1053,
                368
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    69.0,
                    261.0
                ],
                [
                    1053.0,
                    261.0
                ],
                [
                    1053.0,
                    368.0
                ],
                [
                    69.0,
                    368.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1700] The message PowerDeliveryRes shall contain the ResponseCode \"WARNING_StandbyNotAllowed\" if the EVCC has sent a PowerDeliveryReq containing the parameter ChargeProgress set to \"Standby\" and the SECC does not allow for a standby period. All mandatory parameters shall be filled in with arbitrary XSD conform values. All values shall be chosen in a way that results in a minimal size of the response message.",
            "block_bbox": [
                69,
                388,
                1054,
                545
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    69.0,
                    388.0
                ],
                [
                    1054.0,
                    388.0
                ],
                [
                    1054.0,
                    545.0
                ],
                [
                    69.0,
                    545.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The following applies if the EVCC is unable to enter a standby period.",
            "block_bbox": [
                69,
                568,
                722,
                596
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
