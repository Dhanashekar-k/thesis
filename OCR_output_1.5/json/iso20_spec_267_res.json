        {
            "block_label": "text",
            "block_content": "Since the EV energy transfer process is impacted by external factors (e.g. environmental conditions) the predictions of the EVPowerProfile are already subject to uncertainty. Therefore, it is not recommended for the SECC to set a too tight PowerTolerance parameter below 5 % of the EVSEMaximumChargePower because it makes unintended violations of the PowerTolerance band more likely.",
            "block_bbox": [
                68,
                364,
                1054,
                469
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    68.0,
