        {
            "block_label": "text",
            "block_content": "[V2G20-2377] The CPM4PE shall expire on the private SECC at least 120 s after the user activates the mode. Refer to H.2.2.3 for details of CPM4PE.",
            "block_bbox": [
                69,
                239,
                1052,
                292
            ],
            "block_id": 2,
