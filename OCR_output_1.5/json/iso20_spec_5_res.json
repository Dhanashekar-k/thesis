        {
            "block_label": "paragraph_title",
            "block_content": "Introduction",
            "block_bbox": [
                69,
                170,
                241,
                200
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
