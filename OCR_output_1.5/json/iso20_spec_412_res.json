        {
            "block_label": "text",
            "block_content": "[V2G20-1964] If the first ServiceDiscoveryRes message of the service session had the parameter ServiceRenegotiationSupported set to \"True\" and if the parameter EVSENotification in EVSEStatus is equal to \"ServiceRenegotiation\" in AC_ChargeLoopRes, the EVCC shall initiate a ServiceRenegotiation as defined by [V2G20-1969] within the number of seconds provided in NotificationMaxDelay.",
            "block_bbox": [
                136,
                1306,
                1122,
                1438
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
