                    67.0,
                    248.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In some cases that would mean EVCC providing the vehicle sub-CA2 certificate signed by OEM root CA certificate chain while in others it would provide the vehicle sub-CA2 certificate signed by V2G root CA certificate.",
            "block_bbox": [
