                    320.0,
                    537.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 7 By default the mechanism defined by [V2G20-2320] can be set to use (elliptic curve) EC as specified by [V2G20-2674].",
            "block_bbox": [
                137,
                558,
                1120,
                606
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    137.0,
                    558.0
                ],
                [
                    1120.0,
                    558.0
                ],
                [
                    1120.0,
                    606.0
                ],
                [
                    137.0,
                    606.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2675] Each V2G entity shall support a key length of 521 bits for ECC based asymmetric cryptography.",
            "block_bbox": [
                138,
                630,
                1120,
                683
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    138.0,
                    630.0
                ],
                [
                    1120.0,
                    630.0
                ],
                [
                    1120.0,
                    683.0
                ],
                [
                    138.0,
                    683.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 8 Additionally, key length of 448 bits is used with certain curves in the application of this document. If a V2G entity can manage and utilize 521 bit keys, it can be capable of managing and utilizing 448 bit keys as well.",
            "block_bbox": [
                136,
                704,
                1119,
                755
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    136.0,
                    704.0
                ],
                [
                    1119.0,
                    704.0
                ],
                [
                    1119.0,
                    755.0
                ],
                [
                    136.0,
                    755.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2322] Each certificate shall meet all requirements as specified for that certificate in this subclause (and any of its subclauses), 7.3.3 (and any of its subclauses) and in Annex B.",
            "block_bbox": [
                138,
                776,
                1124,
                830
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
                    138.0,
                    776.0
                ],
