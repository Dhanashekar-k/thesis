                    138.0,
                    876.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-926] The certificate extensions mentioned in Annex B shall be supported.",
            "block_bbox": [
                137,
                899,
                969,
                927
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
