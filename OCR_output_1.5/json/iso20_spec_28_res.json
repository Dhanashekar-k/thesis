        {
            "block_label": "text",
            "block_content": "NOTE 5 The design and implementation of this configuration mechanism is not in the scope of this document.",
            "block_bbox": [
                137,
                168,
                1100,
                193
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
