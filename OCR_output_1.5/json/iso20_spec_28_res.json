                ],
                [
                    1124.0,
                    830.0
                ],
                [
                    138.0,
                    830.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 9 Annex B provides the certificate profiles.",
            "block_bbox": [
                138,
                851,
                587,
                876
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
