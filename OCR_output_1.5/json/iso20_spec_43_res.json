                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Trusted network SECCs and SDP servers are part of the trusted network. Access to this network is controlled by the EVSE operator. Only authorized nodes of the operator have access to this network.",
            "block_bbox": [
                68,
                392,
