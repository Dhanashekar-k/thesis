        {
            "block_label": "text",
            "block_content": "This subclause defines firewall functionality, where the term firewall refers to the definition made in ISO/IEC 27033-1. The firewall specified here separates the trusted from the untrusted network, where trusted and untrusted are defined as follows.",
            "block_bbox": [
                68,
                290,
                1053,
                370
            ],
            "block_id": 3,
            "block_order": 3,
