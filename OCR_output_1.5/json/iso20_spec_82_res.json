                ],
                [
                    1118.0,
                    69.0
                ],
                [
                    1118.0,
                    96.0
                ],
                [
                    866.0,
                    96.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The \"NewSessionTicket\" message is also (and interchangeably/commonly) referred to as \"TLS session ticket\" in this document.",
            "block_bbox": [
                136,
                168,
                1120,
                221
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
                    136.0,
                    168.0
                ],
                [
                    1120.0,
                    168.0
                ],
                [
                    1120.0,
                    221.0
                ],
                [
                    136.0,
                    221.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "[V2G20-2023]",
            "block_bbox": [
                139,
                243,
                288,
                270
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    139.0,
                    243.0
                ],
                [
                    288.0,
                    243.0
                ],
                [
                    288.0,
                    270.0
                ],
                [
                    139.0,
                    270.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If the SECC supports VAS services and it allows EVCC to use TLS resumption for VAS, it may send up to the same number of separate/unique \"NewSessionTicket\" messages (as described in IETF RFC 8446) as the number of VAS supported by the SECC.",
            "block_bbox": [
                323,
                243,
                1121,
                348
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    323.0,
                    243.0
                ],
                [
                    1121.0,
                    243.0
                ],
                [
                    1121.0,
                    348.0
                ],
                [
                    323.0,
                    348.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 2 \"NewSessionTicket\" message sets up the PSK for TLS session resumption.",
            "block_bbox": [
                136,
                370,
                867,
                396
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    136.0,
                    370.0
                ],
                [
                    867.0,
                    370.0
                ],
                [
                    867.0,
                    396.0
                ],
                [
                    136.0,
                    396.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 3 Each value added service uses a separate TLS session which are all tied to the same V2G session. Each \"NewSessionTicket\" message provides a unique PSK that can be used to set up a separate, though parallel, resumed TLS session.",
            "block_bbox": [
                137,
                417,
                1120,
                490
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    137.0,
                    417.0
                ],
                [
                    1120.0,
                    417.0
                ],
                [
                    1120.0,
                    490.0
                ],
                [
                    137.0,
                    490.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 4 8.3.4.3.4.3 limits the number of value added services supported by SECC to be eight (8). Hence, at most, additional eight (8) \"NewSessionTicket\" messages are sent out by the SECC to support each separate value added service.",
            "block_bbox": [
                137,
                511,
                1120,
                584
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    137.0,
                    511.0
                ],
                [
                    1120.0,
                    511.0
                ],
                [
                    1120.0,
                    584.0
                ],
                [
                    137.0,
                    584.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2611] The SECC shall follow [V2G20-2023] for every \"Full Handshake\".",
            "block_bbox": [
                138,
                606,
                938,
                634
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    138.0,
                    606.0
                ],
                [
                    938.0,
                    606.0
                ],
                [
                    938.0,
                    634.0
                ],
                [
                    138.0,
                    634.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 5 \"Full Handshake\" can occur multiple times during the same V2G session whenever the V2G session is resumed after a pause.",
            "block_bbox": [
                137,
                655,
                1121,
                705
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
                    137.0,
                    655.0
                ],
                [
                    1121.0,
                    655.0
                ],
                [
                    1121.0,
                    705.0
                ],
                [
                    137.0,
                    705.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2612] The \"ticket_nonce\" sent by the SECC in the \"NewSessionTicket\" message shall have minimum 7 bits of entropy. Refer to 7.3.7 for details. Additional details can be found in IETF RFC 8446:2018, Annex C.1.",
            "block_bbox": [
                137,
                726,
                1120,
                807
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    137.0,
                    726.0
                ],
                [
                    1120.0,
                    726.0
                ],
                [
                    1120.0,
                    807.0
                ],
                [
                    137.0,
                    807.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2024] The SECC shall set \"ticket_lifetime\" in \"NewSessionTicket\" message to be greater than or equal to Minimum_TLS_SessionTicket_Lifetime and less than or equal to Maximum_TLS_SessionTicket_Lifetime. Refer to IETF RFC 8446 for further details of \"ticket_lifetime\".",
            "block_bbox": [
                136,
                828,
                1123,
                932
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
                    136.00013732910156,
                    828.0000610351562
                ],
                [
                    1121.1588134765625,
                    819.9579467773438
                ],
                [
                    1122.0,
                    923.0000610351562
                ],
                [
                    136.84130859375,
                    931.0421752929688
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2025] Minimum_TLS_SessionTicket_Lifetime shall be 20 s.",
            "block_bbox": [
                138,
                955,
                817,
                983
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
                [
                    138.0,
                    955.0
                ],
                [
                    817.0,
                    955.0
                ],
                [
                    817.0,
                    983.0
                ],
                [
                    138.0,
                    983.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 6 This can give both the SECC and the EVCC enough time to transmit/receive and process all the \"NewSessionTicket\" messages. For example, including one for the V2G session, there could be a maximum of 8 \"NewSessionTicket\" messages exchanged between the SECC and the EVCC. This is to ensure that the SECC does not keep sending new tickets per [V2G20-2027]. The ticket lifetime can also be long enough for the EVCC to initiate a VAS communication when needed during the V2G session.",
            "block_bbox": [
                136,
                1006,
                1122,
                1125
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    136.0,
                    1006.0
                ],
                [
                    1122.0,
                    1006.0
                ],
                [
                    1122.0,
                    1125.0
                ],
                [
                    136.0,
                    1125.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2026] Maximum_TLS_SessionTicket_Lifetime shall be 86 400 s (24 h).",
            "block_bbox": [
                138,
                1146,
                923,
                1175
            ],
            "block_id": 13,
            "block_order": 13,
            "group_id": 13,
            "block_polygon_points": [
                [
                    138.0,
                    1146.0
                ],
                [
                    923.0,
                    1146.0
                ],
                [
                    923.0,
                    1175.0
                ],
                [
                    138.0,
                    1175.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 7 Although IETF RFC 8446 supports ticket lifetimes up to 7 days, longer session ticket lifetimes can lead to security issues. Most nominal use cases of TLS session resumption in the context of this document would not need tickets valid longer than a few hours. As such, ticket lifetimes longer than 24 h are not allowed for implementations defined in this document.",
            "block_bbox": [
                135,
                1196,
                1122,
                1293
            ],
            "block_id": 14,
            "block_order": 14,
            "group_id": 14,
            "block_polygon_points": [
                [
                    135.0,
                    1196.0
                ],
                [
                    1122.0,
                    1196.0
                ],
                [
                    1122.0,
                    1293.0
                ],
                [
                    135.0,
                    1293.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "[V2G20-2029]",
            "block_bbox": [
                139,
                1315,
                288,
                1341
            ],
            "block_id": 15,
            "block_order": 15,
            "group_id": 15,
            "block_polygon_points": [
                [
                    139.0,
                    1315.0
                ],
                [
                    288.0,
                    1315.0
                ],
                [
                    288.0,
                    1341.0
                ],
                [
                    139.0,
                    1341.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "It is up to the discretion of the CSO/PE operator whether to support TLS resumption for VAS. If the SECC does not support TLS resumption, the SECC shall not send \"NewSessionTicket\" messages to EVCC.",
            "block_bbox": [
                322,
                1315,
                1121,
                1392
            ],
            "block_id": 16,
            "block_order": 16,
            "group_id": 16,
            "block_polygon_points": [
                [
                    322.0,
                    1315.0
                ],
                [
                    1121.0,
                    1315.0
                ],
                [
                    1121.0,
                    1392.0
                ],
                [
                    322.0,
                    1392.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 8 Lack of support for TLS session resumption eliminates security concerns related to TLS session resumption (refer to [V2G20-2024] for examples of the security concerns).",
            "block_bbox": [
                136,
                1415,
                1120,
                1466
            ],
            "block_id": 17,
            "block_order": 17,
            "group_id": 17,
            "block_polygon_points": [
                [
                    136.0,
                    1415.0
                ],
                [
                    1120.0,
                    1415.0
                ],
                [
                    1120.0,
                    1466.0
                ],
                [
                    136.0,
                    1466.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The \"ticket_lifetime\" according to IETF RFC 8446 shall be less than Minimum_TLS_SessionTicket_Lifetime and greater than Maximum_TLS_SessionTicket_Lifetime.",
            "block_bbox": [
                136,
                1486,
                1119,
                1565
            ],
            "block_id": 18,
