            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2519] The encryption, as specified by [V2G20-2518], requires the generation of a new seed (session key). The seed shall be generated using the method defined in 7.9.2.5.3., with the \"TPM storage key\" from the OEM provisioning certificate extension used as static public key for calculation of the session key as defined by [V2G20-2535]. Also refer to ISO/IEC 11889-3:2015, B.5.1 for further details with respect to TPM 2.0.",
            "block_bbox": [
                67,
                924,
                1054,
                1056
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
