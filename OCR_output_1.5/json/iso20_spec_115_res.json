                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 2 The values from Table 19 are necessary to calculate the \"Name\" (see ISO/IEC 11889-1:2015, Clause 16) of the asymmetric contract key in TPM 2.0 or when parameter selection is based on the \"new parent\" (in this context the new parent would be the storage key). Table 19 also shows the values for the key profile in the case that the OEM chooses to not seal the contract key to a policy, i.e. for the case that the optional policyDigest field of the custom TPM certificate extension in the OEM provisioning certificate is omitted.",
            "block_bbox": [
                67,
                783,
                1054,
                905
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
