        {
            "block_label": "table",
            "block_content": "<table><tr><td rowspan=\"2\" colspan=\"3\">ISO 15118-2 certificate profiles</td><td colspan=\"4\">EV manufacturer: OEM provisioning</td></tr><tr><td>OEM root CA Root</td><td>OEM sub-CA1 Sub</td><td>OEM sub-CA2 Sub</td><td>OEM provisioning certificate Leafs</td></tr><tr><td></td><td></td><td>subjectAltPublicKey</td><td>-</td><td>-</td><td>-</td><td>x (BIT STRING)</td></tr><tr><td rowspan=\"3\">SignatureAlgorithm</td><td colspan=\"2\">AlgorithmIdentifier</td><td>x</td><td>x</td><td>x</td><td>x</td></tr><tr><td colspan=\"2\">algorithm</td><td>x id-Ed448</td><td>x id-Ed448</td><td>x id-Ed448</td><td>x id-Ed448</td></tr><tr><td colspan=\"2\">parameters</td><td>-</td><td>-</td><td>-</td><td>-</td></tr><tr><td colspan=\"3\">SignatureValue</td><td>(Raw BIT STRING)</td><td>(Raw BIT STRING)</td><td>(Raw BIT STRING)</td><td>(Raw BIT STRING)</td></tr></table>",
