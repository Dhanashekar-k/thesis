                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1633] After sending a SessionStopRes, the SECC shall wait at least 5s before closing the TCP connection.",
            "block_bbox": [
                138,
                822,
                1120,
                877
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
