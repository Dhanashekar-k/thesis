        {
            "block_label": "text",
            "block_content": "[V2G20-2007] After receiving the PowerDeliveryReq with EVProcessing set to \"Ongoing\" and ResponseCode starting with \"OK\", the SECC shall ignore the other contents of the PowerDeliveryReq and respond with a PowerDeliveryRes within V2G_SECC_Msg_Performance_Time according to Table 215. The next allowed request shall be PowerDeliveryReq and the V2G_SECC_Sequence_Timeout is set according to Table 215.",
            "block_bbox": [
                135,
                167,
                1121,
                323
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
                    135.0,
