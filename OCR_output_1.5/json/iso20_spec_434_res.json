                    552.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 12 Based on local supply, or other boundary conditions the SECC can renegotiate the applicable power tolerance for a particular charging session.",
            "block_bbox": [
                137,
                574,
                1120,
                625
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    137.0,
                    574.0
                ],
                [
                    1120.0,
                    574.0
                ],
                [
                    1120.0,
                    625.0
                ],
                [
                    137.0,
                    625.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2018] If the PowerDeliveryReq received has ChargeProgress = \"Renegotiate\", the SECC shall respond with a PowerDeliveryRes with ResponseCode = \"FAILED_SequenceError\".",
            "block_bbox": [
                137,
                644,
                1120,
                724
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
