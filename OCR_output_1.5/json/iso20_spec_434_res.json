                    1121.0,
                    323.0
                ],
                [
                    135.0,
                    323.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2008] After receiving the PowerDeliveryReq with EVProcessing set to \"Finished\", the SECC shall respond with a PowerDeliveryRes within V2G_SECC_Msg_Performance_Time according to Table 215.",
            "block_bbox": [
                137,
                346,
                1120,
                424
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
