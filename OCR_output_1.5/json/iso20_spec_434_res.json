                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1632] After receiving the SessionStopReq, the SECC shall respond with a SessionStopRes within V2G_SECC_Msg_Performance_Time according to Table 215.",
            "block_bbox": [
                138,
                746,
                1120,
                804
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
