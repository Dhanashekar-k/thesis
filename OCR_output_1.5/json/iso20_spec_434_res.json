                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1643] If the first ServiceDiscoveryRes of the service session had the parameter ServiceRenegotiationSupported set to \"True\", after receiving the SessionStopReq with ChargingSession set to \"ServiceRenegotiation\" the SECC shall respond with a SessionStopRes with ResponseCode set to \"OK\" within V2G_SECC_Sequence_Timeout according to Table 215. The next allowed request shall be ServiceDiscoveryReq within V2G_SECC_Sequence_Timeout according to Table 215.",
            "block_bbox": [
                136,
                898,
                1122,
                1054
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
