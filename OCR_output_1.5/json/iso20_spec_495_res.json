        {
            "block_label": "table",
            "block_content": "<table><tr><td rowspan=\"14\" colspan=\"3\">ISO 15118-20 certificate profiles</td><td>Cross cross certificate (x) / nc</td><td>OCSP OCSP signer certificate -</td></tr><tr><td>BasicConstraints</td><td>x / c id-ce-basicConstraints</td></tr><tr><td>CA</td><td>true</td></tr><tr><td>PathLength</td><td>-</td></tr><tr><td>CRLDistributionPoints (CRL)</td><td>x / c id-ce-cRLDistributionPoints</td></tr><tr><td>distributionPoint</td><td>(x) (location of the CRL distributer, if not present, defaults to cRLIssuer)</td></tr><tr><td>reasons</td><td>(x) (revocation reasons covered by the CRL)</td></tr><tr><td>cRLIssuer</td><td>(x) (authority that issues the CRL, if not present, defaults to Issuer name above)</td></tr><tr><td>AuthorityInfoAccess (OCSP)</td><td>x / c id-pe-authorityInfoAccess</td></tr><tr><td>accessMethod</td><td>x id-ad-ocsp</td></tr><tr><td>accessLocation</td><td>x (location of the OCSP responder)</td></tr><tr><td>SubjectInfoAccess (CrossCertIndication)</td><td>x / nc id-pe-subjectInfoAccess</td></tr><tr><td>accessMethod</td><td>x id-crossCertIndication (see [V2G20-2604])</td></tr><tr><td>accessLocation</td><td>x &quot;CROSS&quot; (Syntax: An alphanumeric string with a maximum length of 5 characters as described here)</td></tr><tr><td rowspan=\"3\">SignatureAlgorithm</td><td colspan=\"3\">AlgorithmIdentifier</td><td>x</td></tr><tr><td colspan=\"3\">algorithm</td><td>x id-Ed448</td></tr><tr><td colspan=\"3\">parameters</td><td>-</td></tr><tr><td colspan=\"4\">SignatureValue</td><td>(Raw BIT STRING)</td></tr><tr><td colspan=\"4\"></td><td>(This cross certificate profile shall be applied for all cross certificates regardless of the certificate structure.)</td></tr></table>",
