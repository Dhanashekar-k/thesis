            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1832] The EVSETargetActivePower control shall be able to override any limitation that was derived from the EVSEPowerRampLimitation. The same shall apply to any technique which implements a grid code requirement that has a higher priority than power ramp limitation.",
            "block_bbox": [
                70,
                523,
                1052,
                628
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
