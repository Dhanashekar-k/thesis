        {
            "block_label": "text",
            "block_content": "[V2G20-1829] The EVSEPowerRampLimitation shall be applied as a %/min factor to either the EVMaximumChargePower or the EVMaximumDischargePower in order to calculate the highest allowed absolute power change rate per minute.",
            "block_bbox": [
                69,
                168,
                1052,
                248
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
