        {
            "block_label": "text",
            "block_content": "[V2G20-1831] The EVSEPowerRampLimitation shall be respected by the EV when adjusting its power level to external setpoint commands. This includes the reaction to changing maximum power levels as prescribed by the different entries in power schedules or the changes made by the EV user via other input means, like for example a mobile app.",
            "block_bbox": [
                70,
                371,
                1053,
                502
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
