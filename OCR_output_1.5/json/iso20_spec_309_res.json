        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1830] An EVSEPowerRampLimitation value of 0 %/min shall be interpreted as if the parameter was not present. In those cases the SECC does not require any local power ramp limits.",
            "block_bbox": [
                69,
                268,
                1053,
                348
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
