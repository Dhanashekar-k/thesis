                    449.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2566] The SECC shall indicate via AuthorizationServices parameter, in AuthorizationSetupRes message, the authorization service(s) offered by the SECC. The SECC could offer EIM or PnC or both as the authorization service(s).",
            "block_bbox": [
                138,
                472,
                1120,
                551
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    138.0,
                    472.0
                ],
                [
                    1120.0,
