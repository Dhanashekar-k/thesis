                    247.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1220] If in message AuthorizationSetupRes, the SECC does not offer the service \"PnC\" in the parameter AuthorizationServices, the SECC shall use the element EIM_ASResAuthorizationMode.",
            "block_bbox": [
                137,
                268,
                1121,
                347
            ],
            "block_id": 2,
            "block_order": 2,
