        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2096] In case authorization has already been completed by the time AuthorizationSetupReq is received by the SECC or authorization is not necessary, the SECC shall only offer EIM in AuthorizationSetupRes.",
            "block_bbox": [
                137,
                371,
                1121,
                449
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    137.0,
                    371.0
