                    138.0,
                    551.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2567] If the SECC offers only EIM as an authorization service, it shall include parameter EIM_ASResAuthorizationMode in AuthorizationSetupRes message.",
            "block_bbox": [
                138,
                573,
                1121,
                628
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
