            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2568] If the SECC offers PnC as an authorization service, it shall include parameter PnC_ASResAuthorizationMode in AuthorizationSetupRes message.",
            "block_bbox": [
                138,
                649,
