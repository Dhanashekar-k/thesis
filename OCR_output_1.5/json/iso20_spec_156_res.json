        {
            "block_label": "text",
            "block_content": "[V2G20-1219] If in message AuthorizationSetupRes, the SECC offers the service \"PnC\" in the parameter AuthorizationServices, the SECC shall use the element PnC_ASResAuthorizationMode.",
            "block_bbox": [
                137,
                168,
                1121,
                247
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
                    137.0,
