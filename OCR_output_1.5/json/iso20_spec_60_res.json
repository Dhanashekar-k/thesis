                [
                    1120.0,
                    929.0
                ],
                [
                    1120.0,
                    984.0
                ],
                [
                    137.0,
                    984.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE While [V2G20-2134] defines the maximum upper bound allowed in this document, [V2G20-2135] provides a recommendation.",
            "block_bbox": [
                136,
                1004,
                1119,
                1055
            ],
            "block_id": 17,
            "block_order": 17,
            "group_id": 17,
            "block_polygon_points": [
