        },
        {
            "block_label": "text",
            "block_content": "The following requirements define TCP implementation details relative to congestion control, retransmission, timing, initial window size and Selective Acknowledgement for the purpose of improving the overall performance of TCP.",
            "block_bbox": [
                136,
                527,
                1121,
                606
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
