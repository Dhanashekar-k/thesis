                ],
                [
                    137.0,
                    758.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-059] Each V2G entity should compute TCP's retransmission timer according to IETF RFC 6298.",
            "block_bbox": [
                138,
                779,
                1120,
                833
            ],
            "block_id": 14,
            "block_order": 14,
            "group_id": 14,
            "block_polygon_points": [
                [
                    138.0,
                    779.0
