                    1120.0,
                    779.0
                ],
                [
                    1120.0,
                    833.0
                ],
                [
                    138.0,
                    833.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2134] Whenever a TCP retransmission timeout (RTO) is computed in a V2G entity, the RTO shall be lower than 400 ms.",
            "block_bbox": [
                138,
                853,
                1120,
                909
            ],
            "block_id": 15,
            "block_order": 15,
            "group_id": 15,
            "block_polygon_points": [
                [
                    138.0,
                    853.0
                ],
                [
                    1120.0,
                    853.0
                ],
                [
                    1120.0,
                    909.0
                ],
                [
                    138.0,
                    909.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2135] Whenever a TCP retransmission timeout (RTO) is computed in a V2G entity, the RTO should be in the range of 50 ms (lower bound) and 110 ms (upper bound).",
            "block_bbox": [
                137,
                929,
                1120,
                984
            ],
            "block_id": 16,
            "block_order": 16,
            "group_id": 16,
            "block_polygon_points": [
                [
                    137.0,
                    929.0
