                ],
                [
                    137.0,
                    680.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-057] Each V2G entity should implement TCP congestion control according to IETF RFC 5681.",
            "block_bbox": [
                137,
                703,
                1120,
                758
            ],
            "block_id": 13,
            "block_order": 13,
            "group_id": 13,
            "block_polygon_points": [
                [
                    137.0,
                    703.0
                ],
                [
                    1120.0,
