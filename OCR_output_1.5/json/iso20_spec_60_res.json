                [
                    136.0,
                    606.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "It is recommended to use the following congestion control and retransmission algorithms in addition to the standard TCP methods:",
            "block_bbox": [
                137,
                629,
                1120,
                680
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    137.0,
                    629.0
                ],
                [
                    1120.0,
                    629.0
                ],
                [
                    1120.0,
