        },
        {
            "block_label": "text",
            "block_content": "[V2G20-060] To increase TCP's performance each V2G entity should implement TCP extensions for high performance according to IETF RFC 7323.",
            "block_bbox": [
                137,
                1075,
                1120,
                1131
            ],
            "block_id": 18,
