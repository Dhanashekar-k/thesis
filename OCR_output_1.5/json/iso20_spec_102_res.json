            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2489] The ephemeral public key used in requirement [V2G20-2497] shall be contained in the XML element \"DHPublicKey\" encoded in its uncompressed form as \"Subject Public Key\" as defined in IETF RFC 5480.",
            "block_bbox": [
                137,
                1218,
                1120,
                1297
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "block_polygon_points": [
