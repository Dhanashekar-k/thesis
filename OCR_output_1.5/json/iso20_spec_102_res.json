                ],
                [
                    136.0,
                    917.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "20-2487] If the SA uses the elliptic curve corresponding to signature algorithm specified by [V2G20-2674 for contract certificate private key encryption key generation via ECDHE as specified in 7.9.2.5.4, it shall set ECDHCurve parameter in SignedInstallationDataType element of CertificateInstallationRes message to \"SECP521\".",
            "block_bbox": [
                185,
                938,
                1116,
                1068
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "block_polygon_points": [
                [
                    185.0,
                    938.0
                ],
                [
                    1116.0,
                    938.0
                ],
                [
                    1116.0,
                    1068.0
                ],
                [
                    185.0,
                    1068.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2488] If the SA uses the elliptic curve corresponding to signature algorithm specified by [V2G20-2319] for contract certificate private key encryption key generation via ECDHE as specified in 7.9.2.5.4, it shall set ECDHCurve parameter in SignedInstallationDataType element of CertificateInstallationRes message to \"X448\".",
            "block_bbox": [
                135,
                1091,
                1121,
                1197
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "block_polygon_points": [
                [
                    135.0,
