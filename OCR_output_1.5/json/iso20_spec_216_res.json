            "block_label": "table",
            "block_content": "<table><tr><td>Element Name</td><td>Type</td><td>Semantics</td></tr><tr><td rowspan=\"3\">EVPCNaturalFrequency</td><td>complexType</td><td rowspan=\"3\">Self-resonance frequency of the EV device under fully loaded condition (primary device not present)</td></tr><tr><td>RationalNumberType</td></tr><tr><td>refer to 8.3.5.3.8</td></tr><tr><td rowspan=\"2\">EVPCDeviceLocalControl</td><td>simpleType:</td><td rowspan=\"2\">True, if EV device has a local control loop, which modifies reactance or power, false otherwise.</td></tr><tr><td>xs:boolean</td></tr><tr><td rowspan=\"3\">VendorSpecificDataContainer</td><td>simpleType:</td><td>Optional:</td></tr><tr><td>WPT_DataContainerType</td><td rowspan=\"2\">Manufacturer specific data container, containing, e.g. manufacturer ID and Model ID</td></tr><tr><td>refer to Annex A for the type definition</td></tr></table>",
