        {
            "block_label": "text",
            "block_content": "[V2G20-5021] The SECC shall respond with a WPT_ChargeParameterDiscoveryRes with the ResponseCode = OK when the element values received from the EVCC allow a system setup for successful power transfer at the supply device.",
            "block_bbox": [
                137,
                773,
                1120,
                852
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
