        },
        {
            "block_label": "text",
            "block_content": "In general, two pairs of security mechanisms are supported.",
            "block_bbox": [
                68,
                486,
                637,
                513
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
