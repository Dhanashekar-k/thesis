                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2057] If the SECC is required to be backwards compatible to ISO 15118-2, it shall additionally support the certificate profiles defined in ISO 15118-2.",
            "block_bbox": [
                138,
                745,
                1120,
                803
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
