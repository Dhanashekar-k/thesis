                    138.0,
                    648.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2056] If the EVCC is required to be backwards compatible to ISO 15118-2, it shall additionally support the certificate profiles defined in ISO 15118-2.",
            "block_bbox": [
                138,
                669,
                1120,
                726
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
