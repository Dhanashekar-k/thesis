                ],
                [
                    629.0,
                    192.0
                ],
                [
                    218.0,
                    192.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Implementations of this document may be interoperable with earlier versions of th ISO 15118 series (i.e. various editions of ISO 15118-2). To enable an EVCC implementing this document to connect to an SECC implementing a previous revision of 15118 (i.e. various editions of ISO 15118-2), the ClientHello message needs to comply with a specific set of requirements.",
            "block_bbox": [
                136,
                215,
                1121,
                321
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    136.0,
                    215.0
                ],
                [
                    1121.0,
                    215.0
                ],
                [
                    1121.0,
                    321.0
                ],
                [
                    136.0,
                    321.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Similarly, to enable an SECC implementing this document to accept a connection from an EVCC implementing a previous revision of the ISO 15118 series (i.e. various editions of ISO 15118-2), the interpretation of a received ClientHello message needs to comply with a specific set of requirements.",
            "block_bbox": [
                136,
                342,
                1122,
                423
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    136.0,
                    342.0
                ],
                [
                    1122.0,
                    342.0
                ],
                [
                    1122.0,
                    423.0
                ],
                [
                    136.0,
                    423.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Therefore, the following requirements should only be implemented, if an implementation of this document should be backwards compatible. Otherwise the following requirements should be ignored.",
            "block_bbox": [
                136,
                443,
                1121,
                497
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    136.0,
                    443.0
                ],
                [
                    1121.0,
                    443.0
                ],
                [
                    1121.0,
                    497.0
                ],
                [
                    136.0,
                    497.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2054] If the EVCC is required to be backwards compatible to ISO 15118-2, the requirements in 7.7.3.10 shall be implemented.",
            "block_bbox": [
                137,
                518,
                1120,
                574
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    137.0,
                    518.0
                ],
                [
                    1120.0,
                    518.0
                ],
                [
                    1120.0,
                    574.0
                ],
                [
                    137.0,
                    574.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2055] If the SECC is required to be backwards compatible to ISO 15118-2, the requirements in 7.7.3.10 shall be implemented.",
            "block_bbox": [
                138,
                593,
                1120,
                648
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
