        {
            "block_label": "paragraph_title",
            "block_content": "7.7.3.10 TLS backwards compatibility",
            "block_bbox": [
                218,
                165,
                629,
                192
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
                    218.0,
