        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2058] If the EVCC is required to be backwards compatible to ISO 15118-2, it shall include the cipher suites of the ISO 15118-2 in the cipher_suites field of the ClientHello message after the TLS 1.3 cipher suites in the same order as they appear in ISO 15118-2.",
            "block_bbox": [
                137,
                820,
                1121,
                925
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
