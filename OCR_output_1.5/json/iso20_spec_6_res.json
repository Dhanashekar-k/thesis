                    1121.0,
                    617.0
                ],
                [
                    136.0,
                    617.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "This document defines the communication messages and sequence requirements for bidirectional power transfer.",
            "block_bbox": [
                136,
                638,
                1120,
                692
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
