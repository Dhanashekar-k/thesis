                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2551] The SECC shall discard the hash generated by [V2G20-2630] after the hash has been utilized per [V2G20-2550].",
            "block_bbox": [
                70,
                589,
                1053,
                645
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
