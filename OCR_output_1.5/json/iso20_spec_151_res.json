                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2632] The SECC should securely store the hash generated by [V2G20-2553] until it is used per [V2G20-2633].",
            "block_bbox": [
                70,
                842,
                1053,
                899
            ],
            "block_id": 8,
            "block_order": 8,
