                ],
                [
                    1052.0,
                    319.0
                ],
                [
                    68.0,
                    319.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2631] The SECC should securely store the hash generated by [V2G20-2630] until it is used per [V2G20-2550].",
            "block_bbox": [
                68,
                339,
                1052,
                396
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    68.0,
                    339.0
                ],
                [
                    1052.0,
                    339.0
                ],
                [
                    1052.0,
                    396.0
                ],
                [
                    68.0,
                    396.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2550] Once a new SessionID has been assigned to the V2G session, the SECC should calculate the SHA512 hash of the SessionID of the V2G session concatenated with the hash generated by [V2G20-2630]. Refer to [V2G20-2106], [V2G20-2626] and [V2G20-2627] for details of SessionID assignment.",
            "block_bbox": [
                68,
                415,
                1053,
                521
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    68.0,
                    415.0
                ],
                [
                    1053.0,
                    415.0
                ],
                [
                    1053.0,
                    521.0
                ],
                [
                    68.0,
                    521.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 2 SessionIDtoVehicleCertificateBinding = SHA512 (SessionID || SHA512 (vehicle certificate)).",
            "block_bbox": [
                68,
                541,
                951,
                569
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
