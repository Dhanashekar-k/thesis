        {
            "block_label": "text",
            "block_content": "[V2G20-2630] After a successful \"Initial Handshake\" (as described in 7.7.3.5) to setup a TLS session (as described in 7.7.3.3, 7.7.3.4 and 7.7.3.5), the SECC should calculate the SHA512 hash of the vehicle certificate (only the leaf certificate not the entire certificate chain).",
            "block_bbox": [
                68,
                167,
                1053,
                247
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
                    68.0,
                    167.0
                ],
                [
                    1053.0,
                    167.0
                ],
                [
                    1053.0,
                    247.0
                ],
                [
                    68.0,
                    247.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 1 It is not in the scope of this document to define a methodology for the SECC to capture the vehicle certificate from the TLS handshake for the purposes of calculating the hash per this requirement.",
            "block_bbox": [
                68,
                268,
                1052,
                319
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    68.0,
