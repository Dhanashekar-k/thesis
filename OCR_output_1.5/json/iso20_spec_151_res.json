                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2552] The SECC shall securely store the hash generated by [V2G20-2550] until the V2G session associated with the particular SessionID is terminated/closed.",
            "block_bbox": [
                70,
                665,
                1053,
                721
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
