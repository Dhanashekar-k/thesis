            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1438] If EVCC uses ServiceName = DC or DC_BPT from Table 204, after receiving the PowerDeliveryRes with \"ResponseCode = OK\" or \"ResponseCode = WARNING_PowerToleranceNotConfirmed\", the EVCC shall send a DC_ChargeLoopReq within V2G_EVCC_Sequence_Performance_Timeout according to Table 217 to start the energy transfer, a schedule renegotiation or enter a standby period.",
            "block_bbox": [
                68,
                395,
                1053,
                552
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    68.0,
                    395.0
                ],
