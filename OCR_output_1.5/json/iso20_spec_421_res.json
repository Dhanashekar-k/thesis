            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1444] If the EVCC wants to stop the energy transfer and received the DC_ChargeLoopRes with \"ResponseCode = OK\", the EVCC shall send a PowerDeliveryReq with ChargeProgress = \"Stop\" within V2G_EVCC_Sequence_Performance_Timeout according to Table 215.",
            "block_bbox": [
                68,
                803,
                1054,
                908
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
