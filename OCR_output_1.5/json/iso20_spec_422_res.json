        },
        {
            "block_label": "text",
            "block_content": "[V2G20-5026] After receiving a WPT_FinePositioningRes with \"ResponseCode = OK\" and EVSEProcessing set to \"Ongoing\", the EVCC shall send a WPT_FinePositioningReq with EVProcessing set to \"Finished\" when the vehicle positioning is finished within V2G_EVCC_Sequence_Performance_Timeout according to Table 218.",
            "block_bbox": [
                137,
                895,
                1120,
                1001
            ],
            "block_id": 8,
