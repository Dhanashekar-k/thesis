                ],
                [
                    1117.935302734375,
                    300.95062255859375
                ],
                [
                    135.35687255859375,
                    292.9459228515625
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-5046] After receiving the SessionSetupRes with ResponseCode equal to \"OK\", the EVCC shall send a WPT_ChargeParameterDiscoveryReq while V2G_EVCC_Sequence_Timer is smaller than V2G_EVCC_Sequence_Performance_Time, in case EVCC resumes a previously paused V2G communication session.",
            "block_bbox": [
                135,
                315,
                1122,
                422
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
