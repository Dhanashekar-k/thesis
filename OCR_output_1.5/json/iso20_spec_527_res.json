                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In this example of cross signing (example 2 as shown in Figure H.6, there are 2 separate vehicle sub-CA1 certificates:",
            "block_bbox": [
                69,
                343,
                1028,
                399
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
