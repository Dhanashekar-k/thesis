            ]
        },
        {
            "block_label": "text",
            "block_content": "Both of the vehicle sub-CA1 certificates have the same exact public/private key pair.",
            "block_bbox": [
                68,
                486,
                864,
                513
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
