                [
                    102.0,
                    437.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- another that is signed by the V2G root CA certificate.",
            "block_bbox": [
                103,
                438,
                639,
                463
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
