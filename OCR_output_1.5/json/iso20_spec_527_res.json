                    1028.0,
                    343.0
                ],
                [
                    1028.0,
                    399.0
                ],
                [
                    69.0,
                    399.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "— one that is signed by the OEM root CA certificate;",
            "block_bbox": [
                102,
                412,
                609,
                437
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
