        {
            "block_label": "text",
            "block_content": "7.7.3.5 TLS session setup",
            "block_bbox": [
                218,
                684,
                513,
                711
            ],
            "block_id": 8,
            "block_order": 4,
            "group_id": 8,
            "block_polygon_points": [
