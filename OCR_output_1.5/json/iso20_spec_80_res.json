        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1679] The EVCC shall utilize a PSK handshake only to resume a TLS session.",
            "block_bbox": [
                139,
                433,
                981,
                462
            ],
            "block_id": 5,
            "block_order": 1,
            "group_id": 5,
            "block_polygon_points": [
