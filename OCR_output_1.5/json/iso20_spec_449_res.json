        {
            "block_label": "text",
            "block_content": "Certificate profiles are presented in tables, divided into several thematic clusters each containing profiles for specific certificate types. Certificate profiles are based on ITU-T X.509 and IETF RFC 5280 (as updated by IETF RFC 6818, IETF RFC 8398 and IETF RFC 8399).",
            "block_bbox": [
                68,
                419,
                1053,
                499
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    68.0,
                    419.0
                ],
                [
                    1053.0,
                    419.0
                ],
                [
                    1053.0,
                    499.0
                ],
                [
                    68.0,
                    499.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Tables B.x (like Table B.3, Table B.5, Table B.7, Table B.9, Table B.11, Table B.13, Table B.15 or Table B.17) provide certificate profiles for certificates based on the curve as defined by [V2G20-2674].",
            "block_bbox": [
                68,
