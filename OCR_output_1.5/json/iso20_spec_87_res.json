            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2068] The EVCC shall abort the handshake, if a downgrade is detected in the server's random value according to IETF RFC 8446.",
            "block_bbox": [
                70,
                1024,
                1052,
                1078
            ],
            "block_id": 11,
