                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2063] If the EVCC wants/prefers to setup and utilize ISO 15118-2 communications, it shall omit sending supported_versions extension.",
            "block_bbox": [
                70,
                167,
                1052,
                223
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
                    70.0,
                    167.0
                ],
                [
                    1052.0,
                    167.0
                ],
                [
                    1052.0,
                    223.0
                ],
                [
                    70.0,
                    223.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 5 This either forces the SECC to setup a TLS 1.2 session with EVCC or fails to setup any TLS session at all.",
            "block_bbox": [
                69,
                241,
                1045,
                268
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    69.0,
                    241.0
                ],
                [
                    1045.0,
                    241.0
                ],
                [
                    1045.0,
                    268.0
                ],
                [
                    69.0,
                    268.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2064] The EVCC shall continue a TLS 1.2 handshake, as described in ISO 15118-2, if the SECC selected TLS 1.2 and EVCC supports TLS 1.2.",
            "block_bbox": [
                70,
                290,
                1052,
                346
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    70.0,
                    290.0
                ],
                [
                    1052.0,
                    290.0
                ],
                [
                    1052.0,
                    346.0
                ],
                [
                    70.0,
                    346.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2065] The SECC shall perform a TLS 1.2 handshake, as specified in ISO 15118-2, if supported_versions extension is not present in (i.e. missing from) the received ClientHello and the SECC supports TLS 1.2.",
            "block_bbox": [
                70,
                365,
                1054,
                445
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    70.0,
                    365.0
                ],
                [
                    1054.0,
                    365.0
                ],
                [
                    1054.0,
                    445.0
                ],
                [
                    70.0,
                    445.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2066] The SECC shall perform a TLS 1.2 handshake, as specified in ISO 15118-2, if supported_versions extension in the received ClientHello is set to 0x0303 (i.e. no other versions are listed in the supported_versions extension) and the SECC supports TLS 1.2.",
            "block_bbox": [
                71,
                467,
                1054,
                570
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    71.0,
                    467.0
                ],
                [
                    1054.0,
                    467.0
                ],
                [
                    1054.0,
                    570.0
                ],
                [
                    71.0,
                    570.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 6 [V2G20-2356] applies, if a TLS 1.2 handshake is negotiated.",
            "block_bbox": [
                70,
                593,
                677,
                620
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    70.0,
                    593.0
                ],
                [
                    677.0,
                    593.0
                ],
                [
                    677.0,
                    620.0
                ],
                [
                    70.0,
                    620.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 7 A SECC that does not support TLS 1.3 sends a ServerHello without the supported_versions extension, since implementations are required to ignore unknown extensions. In contrast, a server that does support TLS 1.3 sends a supported_version extension containing the selected version (see IETF RFC 8446).",
            "block_bbox": [
                68,
                642,
                1053,
                715
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    68.0,
                    642.0
                ],
                [
                    1053.0,
                    642.0
                ],
                [
                    1053.0,
                    715.0
                ],
                [
                    68.0,
                    715.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 8 The TLS 1.2 and TLS 1.3 ClientHello messages are compatible on the network binary level; i.e. all mandatory fields are present and have the same size in both revisions. TLS 1.3 is specified using extensions to the ClientHello message. Since both TLS 1.2 and TLS 1.3 implementations are required to ignore unknown extensions, a TLS 1.2 implementation can safely ignore any TLS 1.3 mandatory extension. If a TLS 1.3 peer is willing to negotiate TLS 1.2, it can accept the legacy ClientHello and respond with a legacy ServerHello or respectively accept a legacy ServerHello. Refer to IETF RFC 8446:2018, Annex D for further details.",
            "block_bbox": [
                68,
                736,
                1054,
                880
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
                    68.0,
                    736.0
                ],
                [
                    1054.0,
                    736.0
                ],
                [
                    1054.0,
                    880.0
                ],
                [
                    68.0,
                    880.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2067] An SECC trying to establish legacy ISO 15118-2 communication shall not request EVCC to send the EVCC's certificate via \"CertificateRequest\" message.",
            "block_bbox": [
                70,
                901,
                1053,
                955
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    70.0,
                    901.0
                ],
                [
                    1053.0,
                    901.0
                ],
                [
                    1053.0,
                    955.0
                ],
                [
                    70.0,
                    955.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 9 This ensures backwards compatibility with ISO 15118-2 utilizing unilateral authentication.",
            "block_bbox": [
                68,
                976,
                947,
                1003
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
