        {
            "block_label": "text",
            "block_content": "[V2G20-1380] When the EVCC wants to enter a standby period, after having received DC_PreChargeRes with ResponseCode equal to \"OK\" and if the EVCC determines that the EVSE output voltage, as measured inside the EV, has sufficiently been adjusted to the EV RESS voltage, the EVCC shall send a PowerDeliveryReq with ChargeProgress equal to \"Standby, while V2G_EVCC_Sequence_Timer is smaller than V2G_EVCC_Sequence_Performance_Time.",
            "block_bbox": [
                67,
                664,
                1053,
                820
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
