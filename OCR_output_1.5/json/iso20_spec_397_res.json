        {
            "block_label": "text",
            "block_content": "[V2G20-912] After receiving a ScheduleExchangeRes with EVSEProcessing set to \"Finished\" and before sending a DC_CableCheckReq message, the EVCC shall change to CP State C or D as defined in IEC 61851-1.",
            "block_bbox": [
                69,
                334,
                1053,
                413
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
