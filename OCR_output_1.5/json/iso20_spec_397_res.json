        },
        {
            "block_label": "text",
            "block_content": "[V2G20-913] After sending a PowerDeliveryReq message with ChargeProgress equal to \"Stop\" and receiving the corresponding PowerDeliveryRes message, the EVCC shall change to CP State B as defined in IEC 61851-1 before sending the next request message.",
            "block_bbox": [
                68,
                436,
                1053,
                516
            ],
            "block_id": 5,
            "block_order": 5,
