                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2430] If the named group and signature algorithm selected for the TLS session are based on curves as defined by [V2G20-2674] (as per the configurable mechanism as defined by [V2G20-2320]), the vehicle certificate chain provided by the EVCC in the \"Certificate\" message shall be based on profiles as defined in B.8.1.",
            "block_bbox": [
                136,
                1144,
                1121,
                1251
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
                    136.0,
