                    1054.0,
                    658.0
                ],
                [
                    67.0,
                    658.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1957] If the first ServiceDiscoveryRes of the service session had the parameter ServiceRenegotiationSupported set to \"False\" and, after waking up from a Pause, if the SECC does not offer the same ServiceIDs and parameterSetIDs that were selected previously by the EV, then EVCC shall stop the session by sending the message SessionStopReq with parameter ChargingSession equal to \"Terminate\".",
            "block_bbox": [
                67,
                676,
                1055,
                810
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    67.0,
                    676.0
                ],
                [
                    1055.0,
                    676.0
                ],
                [
                    1055.0,
                    810.0
