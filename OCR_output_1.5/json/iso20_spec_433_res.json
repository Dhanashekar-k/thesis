                [
                    67.0,
                    530.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1980] After receiving the ServiceDiscoveryReq, the SECC shall respond with a ServiceDiscoveryRes within V2G_SECC_Msg_Performance_Time according to Table 215, the allowed next request shall be ServiceDetailReq and the V2G_SECC_Sequence_Timeout is set according to Table 215.",
            "block_bbox": [
                67,
                549,
                1054,
                658
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    67.0,
                    549.0
                ],
