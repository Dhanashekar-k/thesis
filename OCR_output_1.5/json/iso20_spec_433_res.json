                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1981] After receiving the ServiceDetailReq the SECC shall respond with a ServiceDetailRes within V2G_SECC_Msg_Performance_Time according to Table 215. The allowed next requests shall be either ServiceDetailReq or ServiceSelectionReq and the V2G_SECC_Sequence_Timeout is set according to Table 215.",
            "block_bbox": [
                68,
                829,
                1055,
                937
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    68.0,
