        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1984] After sending the ServiceSelectionRes with ResponseCode = \"OK\", the SECC shall be ready to offer any of the value added services it may support, i.e. Internet_Service, ParkingStatus_Service, and/or ACDP_SystemStatus_Service as listed in Table 204.",
            "block_bbox": [
                68,
                1058,
                1054,
                1140
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
