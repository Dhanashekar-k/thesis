            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1983] After receiving the ServiceSelectionReq, the SECC shall respond with ServiceSelectionRes within V2G_SECC_Msg_Performance_Time according to Table 215.",
            "block_bbox": [
                69,
                957,
                1054,
                1037
