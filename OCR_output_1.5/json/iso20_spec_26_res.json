        {
            "block_label": "text",
            "block_content": "While storing any data related to certificates/messages provided by the EVCC, the EVSE and the SAs (including CSO/eMSP/OEM/etc.) should be cognizant of the local/state/national/international privacy rules, regulations and requirements. These rules/regulations/requirements are not in the scope of this document but should be taken into account when designing and implementing the solution.",
            "block_bbox": [
                136,
                168,
                1122,
                274
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
