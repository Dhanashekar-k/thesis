        {
            "block_label": "text",
            "block_content": "IETF RFC 8446:2018, Annex E provides some security risks associated with TLS 1.3 and suggests a few mitigation techniques. The implementers should be cognizant of these and should carefully consider pros and cons of each mitigation technique before incorporating it in the solution.",
            "block_bbox": [
                68,
                1303,
                1053,
                1382
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
