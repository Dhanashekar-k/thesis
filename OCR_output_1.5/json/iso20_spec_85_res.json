                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "At the discretion of CSO, the SECC may cache OCSP responses for vehicle certificate for later use. The next time the SECC receives the vehicle certificates for the same EVCC, it may use the cached OCSP responses, if still valid, for revocation status thereby saving time. The methodology to achieve this is not in the scope of this document. It should be noted, though, that relying on the cached OCSP response here will mean that latest updates to that certificate's status could be missed. Refer to 7.3.1 when implementing OCSP response caching.",
            "block_bbox": [
