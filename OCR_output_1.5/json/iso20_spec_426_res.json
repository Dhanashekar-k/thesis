                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-4059] When SECC experiences an emergency situation, and EVCC is using ServiceName = DC_ACDP in Table 204 the EVSE shall set CP state to E.",
            "block_bbox": [
                137,
                889,
                1119,
                943
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
