                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 2 In case high level communication is disturbed or the ACDP is actually blocked from reaching the predefined safe position a procedure can be agreed upon to mobilize the EV in a safe way. A visual confirmation by the driver that the pantograph is actually in a safe position, after which he can manually get the EV in a mobilized state.",
            "block_bbox": [
                136,
                964,
                1121,
                1059
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
