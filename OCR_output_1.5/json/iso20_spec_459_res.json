        },
        {
            "block_label": "text",
            "block_content": "NOTE 1 IETF RFC5280 has been updated by IETF RFC 6818, IETF RFC 8398 and IETF RFC 8399. These updates are considered to be included in this document.",
            "block_bbox": [
                68,
                951,
