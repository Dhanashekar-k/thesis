        },
        {
            "block_label": "text",
            "block_content": "As such, these fields (basic certificate fields \"TbsCertificate\", \"SignatureAlgorithm\" and \"SignatureValue\") are not marked as mandatory or critical in the certificate profiles below.",
            "block_bbox": [
                68,
                167,
                1052,
                223
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
