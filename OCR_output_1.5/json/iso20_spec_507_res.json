        {
            "block_label": "algorithm",
            "block_content": "The <EVCCID> shall be interpreted as case-insensitive, i.e. \"DE8-V-AA0000453C4D58Y-2\" is exactly the same ID as \"de8-V-aA0000453C4d58y-2\".",
            "block_bbox": [
                245,
