        {
            "block_label": "text",
            "block_content": "[V2G20-2103] Unless defined otherwise DepartureTime in all messages shall always be larger than zero.",
            "block_bbox": [
                70,
                855,
                1052,
                912
            ],
            "block_id": 3,
            "block_order": 1,
            "group_id": 3,
            "block_polygon_points": [
