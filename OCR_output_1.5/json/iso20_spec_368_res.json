        {
            "block_label": "text",
            "block_content": "[V2G20-1215] In case scheduled control mode was selected, unless otherwise stated, anytime an element is prefixed with Scheduled (e.g. Scheduled_SEReqControlMode), it shall be used. Anytime an element is prefixed with dynamic (e.g. Dynamic_SEReqControlMode), it shall not be used.",
            "block_bbox": [
                136,
