        {
            "block_label": "text",
            "block_content": "[V2G20-1214] In case dynamic control mode was selected, unless otherwise stated, anytime an element is prefixed with dynamic (e.g. Dynamic_SEReqControlMode), it shall be used. Anytime an element is prefixed with scheduled (e.g. Scheduled_SEReqControlMode), it shall not be used.",
            "block_bbox": [
                136,
                243,
                1120,
                347
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
