        {
            "block_label": "table",
            "block_content": "<table><tr><td>Element Name</td><td>Type</td><td>Semantics</td></tr><tr><td>Header</td><td>complexType:MessageHeaderTypeRefer to 8.3.3</td><td>Contains general information, used for all messages.</td></tr><tr><td>SelectedAuthorizationService</td><td>simple Type:authorizationTypeenumerationrefer to Annex A for the type definition</td><td>A parameter that indicates which Authorization Service, which was provided by the EVSE, is chosen by the EV.</td></tr><tr><td>EIM_AReqAuthorizationMode</td><td>complexType:EIM_AReqAuthorizationModeTyperefer to 8.3.5.3.31</td><td>Element to be sent when EIM is chosen as Authorization Method.</td></tr><tr><td>PnC_AReqAuthorizationMode</td><td>complexType:PnC_AReqAuthorizationModeTyperefer to 8.3.5.3.32</td><td>This element contains both the challenge sent by the SECC in AuthorizationSetupRes and the EVCC&#x27;s contract certificate</td></tr></table>",
            "block_bbox": [
                73,
                198,
                1048,
                733
            ],
            "block_id": 2,
            "block_order": null,
            "group_id": 2,
            "block_polygon_points": [
