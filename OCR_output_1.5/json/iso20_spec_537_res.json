                    730.0
                ]
            ]
        },
        {
            "block_label": "vision_footnote",
            "block_content": "These are just some examples. Exceptions in the implementations of PE are possible.",
            "block_bbox": [
                71,
                733,
                869,
                760
            ],
            "block_id": 2,
            "block_order": null,
            "group_id": 2,
            "block_polygon_points": [
                [
                    71.0,
