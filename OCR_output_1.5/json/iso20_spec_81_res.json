                ],
                [
                    70.0,
                    1419.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "TLS session resumption in this document is performed via the \"PSK Handshake\" as defined in IETF RFC 8446 using \"pre_shared_key\" in the \"ClientHello\" and \"ServerHello\" messages. Refer to IETF RFC 8446 for further details.",
            "block_bbox": [
