                ],
                [
                    68.0,
                    870.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "7.7.3.7 TLS session resumption",
            "block_bbox": [
                151,
                890,
                506,
                917
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    151.0,
                    890.0
                ],
                [
                    506.0,
                    890.0
                ],
                [
                    506.0,
                    917.0
                ],
                [
                    151.0,
                    917.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "TLS session cannot be paused, but it can be closed (terminated). Refer to 7.7.3.8 for details of TLS session termination.",
            "block_bbox": [
                68,
                939,
                1053,
                992
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
                    68.0,
                    939.0
                ],
                [
                    1053.0,
                    939.0
                ],
                [
                    1053.0,
                    992.0
                ],
                [
                    68.0,
                    992.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A closed TLS session can be restarted/resumed if the server (SECC) provided the client (EVCC) with the necessary information to resume the TLS session. The resumed TLS session, as described by IETF RFC 8446 is cryptographically bound to the initial TLS session without the need for re-authentication of the server/client certificates saving valuable time in time-critical applications.",
            "block_bbox": [
                68,
                1015,
                1054,
                1120
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
                [
                    68.0,
                    1015.0
                ],
                [
                    1054.0,
                    1015.0
                ],
                [
                    1054.0,
                    1120.0
                ],
                [
                    68.0,
                    1120.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A TLS session resumption requires usage of \"Session Tickets\". The session ticket, in IETF RFC 8446, ensures that the client has access to the session credentials negotiated in the TLS handshake.",
            "block_bbox": [
                68,
                1142,
                1053,
                1196
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    68.0,
                    1142.0
                ],
                [
                    1053.0,
                    1142.0
                ],
                [
                    1053.0,
                    1196.0
                ],
                [
                    68.0,
                    1196.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In the application of ISO 15118-20, TLS session resumption can be used to ensure that the value added service can be securely related to an already established V2G session. TLS session resumption cannot be used for V2G session resumption. Only full-handshake TLS can be used for V2G session resumption. Both TLS resumption and TLS full-handshake can be used for opening a VAS communication.",
            "block_bbox": [
                68,
                1218,
                1054,
                1324
            ],
            "block_id": 13,
            "block_order": 13,
            "group_id": 13,
            "block_polygon_points": [
                [
                    68.0,
                    1218.0
                ],
                [
                    1054.0,
                    1218.0
                ],
                [
                    1054.0,
                    1324.0
                ],
                [
                    68.0,
                    1324.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2021] 0-RTT shall not be used for TLS session resumption.",
            "block_bbox": [
                70,
                1345,
                753,
                1373
            ],
            "block_id": 14,
            "block_order": 14,
            "group_id": 14,
            "block_polygon_points": [
                [
                    70.0,
                    1345.0
                ],
                [
                    753.0,
                    1345.0
                ],
                [
                    753.0,
                    1373.0
                ],
                [
                    70.0,
                    1373.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 1 0-RTT can lead to replay attacks.",
            "block_bbox": [
                70,
                1394,
                452,
                1419
            ],
            "block_id": 15,
            "block_order": 15,
            "group_id": 15,
            "block_polygon_points": [
                [
                    70.0,
                    1394.0
                ],
                [
                    452.0,
                    1394.0
                ],
                [
                    452.0,
