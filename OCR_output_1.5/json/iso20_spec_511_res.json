        {
            "block_label": "paragraph_title",
            "block_content": "E.1 Overview",
            "block_bbox": [
                69,
                368,
                233,
                396
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    69.0,
