        {
            "block_label": "paragraph_title",
            "block_content": "H.2.2.2 Installation of a PE certificate into an EVSE",
            "block_bbox": [
                136,
                935,
                663,
                962
            ],
            "block_id": 4,
            "block_order": 2,
