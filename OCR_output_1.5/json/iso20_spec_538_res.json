        },
        {
            "block_label": "text",
            "block_content": "For challenge 2, after the manufacturer has installed their root CA certificate chain in the device/EV, the root CA certificates of other manufacturers to enable mutual authentication are still missing.",
            "block_bbox": [
                136,
                1411,
                1120,
                1465
            ],
            "block_id": 10,
            "block_order": 8,
            "group_id": 10,
