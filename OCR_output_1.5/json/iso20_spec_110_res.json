        {
            "block_label": "paragraph_title",
            "block_content": "7.9.2.5.2.3.3 Decryption of 448-bit contract certificate private key for EVCC without TPM 2.0",
            "block_bbox": [
                136,
                370,
                1087,
                398
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
