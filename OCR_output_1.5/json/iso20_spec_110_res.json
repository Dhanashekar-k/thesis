        {
            "block_label": "text",
            "block_content": "507] Upon receipt of a contract certificate, the EVCC shall verify that the 521 bit private key received with the certificate is a valid 521 bit private key for that certificate:",
            "block_bbox": [
                242,
                168,
                1117,
                220
