        {
            "block_label": "text",
            "block_content": "[V2G20-1416] If the parameter EVSENotification in EVSEStatus is equal to Terminate, the EVCC shall stop charging within the number of seconds provided in NotificationMaxDelay.",
            "block_bbox": [
                68,
                1399,
