                    68.0,
                    348.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "For ACDP a pairing and positioning device (PPD) mounted on the infrastructure applies as described in EN 50696:2021, A.2 and A.3.",
            "block_bbox": [
                69,
                371,
                1053,
                423
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
