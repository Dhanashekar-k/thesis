                    423.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 1 An architecture using a single AP with single SECC, and single PPD can be viewed as a special version of the Multiple SECC architecture and is therefore also a permitted communication architecture.",
            "block_bbox": [
                69,
                445,
                1054,
                496
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
