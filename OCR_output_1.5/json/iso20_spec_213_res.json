        {
            "block_label": "text",
            "block_content": "[V2G20-5008] To start the pairing process the EVCC shall send a WPT_PairingReq message.",
            "block_bbox": [
                71,
                1169,
                980,
                1197
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
