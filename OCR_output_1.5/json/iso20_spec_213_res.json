                    71.0,
                    1197.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-5012] If the EVCC has identified a pairing code it shall send a WPT_PairingReq message with the parameter ObservedIDCode set to the pairing identification code and the EVProcessing parameter set to \"Finished\".",
            "block_bbox": [
                71,
                1218,
                1052,
                1297
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
