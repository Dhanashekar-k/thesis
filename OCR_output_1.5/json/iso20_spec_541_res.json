                    67.0,
                    222.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "When possible EVs could use their knowledge of a GPS coordinate to implement plausibility checks based on \"geolocation fencing\" algorithms to check if a presented PE private root CA certificates is plausible in a given location and ask for confirmation from the driver in uncertain cases.",
            "block_bbox": [
                68,
                242,
                1054,
                324
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
