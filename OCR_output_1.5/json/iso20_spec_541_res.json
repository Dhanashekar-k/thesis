        {
            "block_label": "text",
            "block_content": "maintain other trust anchors used in PE. This will remove some of the disadvantages/challenges associated with each of these challenges.",
            "block_bbox": [
                67,
                168,
                1052,
                222
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
                    67.0,
                    168.0
                ],
                [
                    1052.0,
                    168.0
                ],
                [
                    1052.0,
                    222.0
                ],
