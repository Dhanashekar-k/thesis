        {
            "block_label": "table",
            "block_content": "<table><tr><td>Element name</td><td>Type</td><td>Semantics</td></tr><tr><td>EVMaximumChargePower</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Maximum charge power supported by the EV.</td></tr><tr><td>EVMinimumChargePower</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Any target power between this level and zero may, for technical reasons, result in a drop of the actual power to zero watts.</td></tr><tr><td>EVMaximumChargeCurrent</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Maximum charge current supported by the EV.</td></tr><tr><td>EVMinimumChargeCurrent</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Any target current between this level and zero may, for technical reasons, result in a drop of the actual current to zero ampere.</td></tr><tr><td>EVMaximumVoltage</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Maximum voltage allowed by the EV.</td></tr><tr><td>EVMinimumVoltage</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Minimum voltage allowed by the EV.</td></tr><tr><td>TargetSOC</td><td>simpleType: percentValueType refer to Annex A for the type definition</td><td>Optional: SOC at which the EV considers the battery to be fully charged.</td></tr></table>",
