                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 2 During schedule renegotiation, the SECC can use EVSETargetActivePower (phase specific if necessary) in the ChargeLoopRes on the mainstream communication channel to limit the power drawn by the EVCC temporarily.",
            "block_bbox": [
