        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1845] When the SECC wants to trigger a schedule renegotiation, it shall set the parameter EVSENotification to ScheduleRenegotiation in ChargeLoopRes on the mainstream communication channel.",
            "block_bbox": [
                70,
                759,
                1053,
                839
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
