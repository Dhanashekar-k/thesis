            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 1 After the PowerDeliveryRes on V2GTP payload type ScheduleRenegotiationPayloadID with ResponseCode = OK, no further message exchange on V2GTP payload type ScheduleRenegotiationPayloadID is expected for this schedule renegotiation session.",
            "block_bbox": [
                69,
                370,
                1053,
                444
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
