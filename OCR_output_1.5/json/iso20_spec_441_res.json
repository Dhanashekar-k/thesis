                    272.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1049] To exit the schedule renegotiation process, the SECC shall send a PowerDeliveryRes on V2GTP payload type ScheduleRenegotiationPayloadID with ResponseCode = OK.",
            "block_bbox": [
                70,
                295,
                1051,
                349
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
