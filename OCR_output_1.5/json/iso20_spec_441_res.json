            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1050] The new EVPowerProfile as a result from the schedule renegotiation session shall be applied in the next ChargeLoopReq on the mainstream communication channel.",
            "block_bbox": [
                69,
                465,
                1051,
                520
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
