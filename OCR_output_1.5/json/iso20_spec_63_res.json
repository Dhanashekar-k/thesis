                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 7 The \"authorities\" element contains \"DistinguishedName\" of the V2G root CA certificate(s) and PE private root CA certificate(s) supported by the EVCC.",
            "block_bbox": [
                68,
