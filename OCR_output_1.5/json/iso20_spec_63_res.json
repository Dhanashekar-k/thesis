        {
            "block_label": "text",
            "block_content": "NOTE 6 If the EVCC has V2G root CA certificate(s) and/or PE private root CA certificate(s) based on curves as defined by [V2G20-2674] and [V2G20-2319], it will include both in the \"certificate_authorities\" extension in the \"ClientHello\" message.",
            "block_bbox": [
                68,
                1080,
                1053,
                1154
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
