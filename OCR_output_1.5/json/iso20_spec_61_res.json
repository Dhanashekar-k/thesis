        {
            "block_label": "text",
            "block_content": "The user datagram protocol (UDP) is a connectionless protocol. UDP does not provide the reliability and ordering guarantees that TCP provides. Packets may arrive out of order or may be lost without notification to the sender or receiver. However, UDP is faster and more efficient for many lightweight or time-sensitive purposes. UDP is located on the transport layer of the OSI layered architecture model.",
            "block_bbox": [
                67,
                215,
                1054,
                321
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    67.0,
                    215.0
                ],
                [
                    1054.0,
                    215.0
                ],
                [
                    1054.0,
                    321.0
                ],
                [
                    67.0,
                    321.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Optional security mechanisms are provided in 7.5.1 to secure UDP over WLAN. Currently there is no PLC based use case utilizing UDP, for which security mechanisms on UDP would be required (refer to ISO 15118-1 for details on security use cases).",
            "block_bbox": [
                68,
                342,
                1053,
                422
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
