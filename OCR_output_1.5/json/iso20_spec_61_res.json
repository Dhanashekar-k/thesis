        {
            "block_label": "paragraph_title",
            "block_content": "7.7.3 Transport layer security (TLS)",
            "block_bbox": [
                140,
                538,
                527,
                565
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
