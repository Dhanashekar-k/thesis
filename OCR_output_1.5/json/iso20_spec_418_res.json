        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1446] After receiving the PowerDeliveryRes with \"ResponseCode = OK\" and if the previous PowerDeliveryReq message has ChargeProgress = \"Stop\", the EVCC shall stop all multiplexed communication.",
            "block_bbox": [
                137,
                952,
                1122,
                1031
