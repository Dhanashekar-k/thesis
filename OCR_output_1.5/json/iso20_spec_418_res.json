                    830.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1436] If the EVCC is not finished calculating the EVPowerProfile, the EVCC shall send a PowerDeliveryReq with EVProcessing set to \"Ongoing\" within V2G_EVCC_Sequence_Performance_Timeout according to Table 215.",
            "block_bbox": [
                137,
                851,
                1120,
                931
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
