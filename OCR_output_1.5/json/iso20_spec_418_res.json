                ],
                [
                    137.0,
                    323.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1591] After receiving the ServiceSelectionRes with \"ResponseCode = OK\", the EVCC may start Internet_Service or ParkingStatus_Service as listed in Table 204.",
            "block_bbox": [
                136,
                344,
                1120,
                401
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    136.0,
                    344.0
                ],
                [
                    1120.0,
                    344.0
                ],
                [
                    1120.0,
                    401.0
                ],
                [
                    136.0,
                    401.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1592] After receiving the ServiceSelectionRes with \"ResponseCode = OK\", if there are already existing services, i.e. Internet_Service or ParkingStatus_Service as listed in Table 204, which have not been stopped earlier, these services shall be stopped.",
            "block_bbox": [
                137,
                419,
                1122,
                501
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    137.0,
                    419.0
                ],
                [
                    1122.0,
                    419.0
                ],
                [
                    1122.0,
                    501.0
                ],
                [
                    137.0,
                    501.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2658] After receiving the ChargeParameterDiscoveryReq, the SECC shall send an ChargeParameterDiscoveryRes within V2G_SECC_Msg_Performance_Time according to Table 215. The next allowed request shall be ScheduleExchangeReq and the V2G_SECC_Sequence_Timeout is set according to Table 215.",
            "block_bbox": [
                137,
                521,
                1121,
                626
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    137.0,
                    521.0
                ],
                [
                    1121.0,
                    521.0
                ],
                [
                    1121.0,
                    626.0
                ],
                [
                    137.0,
                    626.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2659] After receiving the ChargeParameterDiscoveryRes with \"ResponseCode = OK\", the EVCC shall send a ScheduleExchangeReq within V2G_EVCC_Sequence_Performance_Timeout according to Table 215.",
            "block_bbox": [
                138,
                648,
                1121,
                729
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    138.0,
                    648.0
                ],
                [
                    1121.0,
                    648.0
                ],
                [
                    1121.0,
                    729.0
                ],
                [
                    138.0,
                    729.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1593] After receiving the ScheduleExchangeRes with \"ResponseCode = OK\" and EVSEProcessing set to \"Ongoing\", the EVCC shall send another ScheduleExchangeReq within V2G_EVCC_Sequence_Performance_Timeout according to Table 215.",
            "block_bbox": [
                138,
                748,
                1121,
                830
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
