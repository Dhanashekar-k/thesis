            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-904]\nThe SECC/SA may verify the signature of the SignedMeteringData element of the MeteringConfirmationReq message using the contract certificate it has received in AuthorizationReq. If this verification fails, the MeteringConfirmationReq shall be regarded as invalid.",
            "block_bbox": [
                138,
                708,
                275,
                737
            ],
            "block_id": 6,
