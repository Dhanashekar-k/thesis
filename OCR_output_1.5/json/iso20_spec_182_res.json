        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1808] The EVCC shall sign the SignedMeteringData using the contract certificate's private key, which is also being used for authorization of the services in the currently active V2G communication/service session.",
            "block_bbox": [
                137,
                442,
                1120,
                520
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
                [
