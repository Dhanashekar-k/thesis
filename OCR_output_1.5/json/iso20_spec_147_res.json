            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 1 To enable pause when using ServiceName = DC_ACDP the common requirements [V2G20-1227], [V2G20-1541], [V2G20-1839], [V2G20-1840], [V2G20-1841], [V2G20-1842], [V2G20-1843] and [V2G20-1844] apply.",
            "block_bbox": [
