                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 9 In case of a resumed session, the AuthorizationReq/Res messages are not required as authorization details of the previous communication session are valid for the whole service session, see [V2G20-1844].",
            "block_bbox": [
                136,
                819,
                1120,
