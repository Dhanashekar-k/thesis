                    1123.0,
                    596.0
                ],
                [
                    135.0,
                    596.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOTE 8 An example of this methodology is provided in 8.3.4.1.1.",
            "block_bbox": [
                137,
                619,
                718,
                645
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
