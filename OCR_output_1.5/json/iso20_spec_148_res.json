            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1032] After resuming a previously paused V2G communication session, following a SessionSetupReq, the SECC shall respond with a SessionSetupRes within V2G_SECC_Msg_Performance_Time according to Table 215. The allowed next request shall be ChargeParameterDiscoveryReq within the V2G_SECC_Sequence_Timeout according to Table 215.",
            "block_bbox": [
                137,
                666,
                1120,
                797
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
