        {
            "block_label": "paragraph_title",
            "block_content": "7.9.2.5.2.2.3 Encryption of 448 bit contract certificate private key for EVCC without TPM 2.0",
            "block_bbox": [
                70,
                794,
                1013,
                822
            ],
            "block_id": 4,
            "block_order": 1,
            "group_id": 4,
            "block_polygon_points": [
