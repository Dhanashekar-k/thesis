        {
            "block_label": "text",
            "block_content": "[V2G20-2113] After receiving the PowerDeliveryRes with ResponseCode equal to \"OK\" as a response to a previous PowerDeliveryReq message with ChargeProgress equal to \"Standby\", the EVCC shall send a ChargeLoopReq while V2G_EVCC_Sequence_Timer is smaller than V2G_EVCC_Sequence_Performance_Time.",
            "block_bbox": [
                135,
                242,
                1123,
                348
