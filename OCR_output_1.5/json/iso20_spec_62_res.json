        {
            "block_label": "text",
            "block_content": "The EVCC provides a certificate chain comprising its own vehicle certificate and corresponding sub-CA certificate(s). The EVCC does not provide revocation status with the certificate chain it sends. The public SECC contacts the OCSP responder or CRL provider for revocation status of each certificate it received in the vehicle certificate chain from the EVCC. Similarly, if the private SECC offers PnC, the private SECC will contact the OCSP responder or CRL provider for revocation status of each certificate it received in the vehicle certificate chain from the EVCC.",
            "block_bbox": [
                135,
                243,
                1122,
                400
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
