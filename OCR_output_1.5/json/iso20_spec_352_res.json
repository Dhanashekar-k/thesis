        {
            "block_label": "table",
            "block_content": "<table><tr><td>Element name</td><td>Type</td><td>Semantics</td></tr><tr><td>AckMaxDelay</td><td>simpleType: xs:unsignedShort</td><td>Optional: This value indicates the maximum delay in seconds that SECC expects the EVCC to apply new mobility needs (DepartureTime or TargetSOC or MinimumSOC) and send updated values in a Charge Loop message since the reception of the message stating the AckMaxDelay.</td></tr><tr><td>EVSEMaximumChargePower</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Maximum power the EVSE can deliver.</td></tr><tr><td>EVSEMinimumChargePower</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Minimum power the EVSE can deliver.</td></tr><tr><td>EVSEMaximumChargeCurrent</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Maximum current the EVSE can deliver.</td></tr><tr><td>EVSEMaximumVoltage</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Maximum voltage the EVSE can deliver.</td></tr><tr><td>EVSEMaximumDischargePower</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Maximum discharge power the EVSE can deliver.</td></tr><tr><td>EVSEMinimumDischargePower</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Any target power between this level and zero may, for technical reasons, result in a drop of the actual power to zero watts.</td></tr><tr><td>EVSEMaximumDischargeCurrent</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Maximum discharge current the EVSE can deliver.</td></tr><tr><td>EVSEMinimumVoltage</td><td>complexType: RationalNumberType refer to 8.3.5.3.8</td><td>Minimum voltage the EVSE can deliver.</td></tr></table>",
