                    395.0
                ],
                [
                    1053.0,
                    502.0
                ],
                [
                    69.0,
                    502.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1480] The EVCC shall only consider the status of the parameter ServiceRenegotiationSupported sent in the first ServiceDiscoveryRes of the service session.",
            "block_bbox": [
                68,
                522,
                1054,
                602
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
