                    602.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1661] If the first ServiceDiscoveryRes message of the service session had the parameter ServiceRenegotiationSupported set to \"True\" and the EVCC decided to perform a ServiceRenegotiation for adapting its service selection, the EVCC shall send a PowerDeliveryReq with parameter ChargeProgress set to \"Stop\" after ChargeLoopRes has been received while V2G_EVCC_Sequence_Timer is smaller than V2G_EVCC_Sequence_Performance_Time.",
            "block_bbox": [
                67,
                624,
                1054,
                781
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
