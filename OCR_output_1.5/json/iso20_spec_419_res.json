        {
            "block_label": "text",
            "block_content": "NOTE 5 As the renegotiation of a service requires to properly end the current charging session (energy transfer) the EVCC will process all required messages (depending on currently selected service) to session stop where the request for a ServiceRenegotiation is to be set according to [V2G20-1476].",
            "block_bbox": [
