                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "This subclause applies to all certificate types and profiles.",
            "block_bbox": [
                136,
                906,
                684,
                934
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
