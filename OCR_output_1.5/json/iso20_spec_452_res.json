        {
            "block_label": "text",
            "block_content": "The OID repository [99] also refers to id-tpmStorageKey as tpmStorageKey(4) (see NOTE 1 in this subclause providing the OID value for id-tpmStorageKey).",
            "block_bbox": [
                136,
                167,
