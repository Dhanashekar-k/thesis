        },
        {
            "block_label": "text",
            "block_content": "[V2G20-2685]\nAny extension or field/parameter/attribute/data type (or sub-field/sub-parameter/sub-attribute/sub-data type or sub-sub-field/sub-sub-parameter/sub-sub-attribute/sub-sub-data type or etc.) not defined in the certificate profiles defined by this document shall not be included in any certificate conforming to this document.",
            "block_bbox": [
                138,
