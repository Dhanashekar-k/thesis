                    136.0,
                    223.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The OID repository [99] also refers to id-tpmPolicyDigest as tpmPolicyDigest(5) (see NOTE 1 in this subclause providing the OID value for id-tpmPolicyDigest).",
            "block_bbox": [
                136,
                242,
                1121,
                298
            ],
            "block_id": 2,
