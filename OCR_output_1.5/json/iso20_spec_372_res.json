        {
            "block_label": "text",
            "block_content": "The BPT channel parameter is used to make a distinction between single and dual channel architectures. In the former one, one single meter is used for the energy flows. In the later one, two separate meters are used for the two opposite energy flows. As a consequence, two switches are used and turned on / off depending on the current flow direction. The BPT channel parameter is used in both AC and DC charging services.",
            "block_bbox": [
                135,
                991,
                1123,
                1123
            ],
            "block_id": 6,
            "block_order": 3,
            "group_id": 6,
            "block_polygon_points": [
                [
                    135.0,
