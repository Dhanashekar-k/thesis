        {
            "block_label": "text",
            "block_content": "[V2G20-2133] The namespaces \"urn:iso:std:iso:15118:-20:CommonMessages\" and \"urn:iso:std:iso:15118:-20:CommonTypes\" shall never be used in the context of the supportedAppProtocolReq.",
            "block_bbox": [
                135,
