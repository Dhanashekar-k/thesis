        {
            "block_label": "text",
            "block_content": "[V2G20-171] All additional data elements defined by the respective minor version shall be encoded as schema deviated case by the EXI coder (see also EXI option settings in 7.9.1.3).",
            "block_bbox": [
                136,
                269,
                1121,
                348
