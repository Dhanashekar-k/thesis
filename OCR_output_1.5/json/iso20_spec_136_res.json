                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "[V2G20-1837] EVSE that supports basic charging as defined in IEC61851-1 shall revert to basic charging after sending a ResponseCode equal to \"Failed_NoNegotiation\" in the supportedAppProtocolRes message.",
            "block_bbox": [
                137,
                624,
                1121,
                705
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
